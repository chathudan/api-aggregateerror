[
  {
    "id": "service-a",
    "name": "Service A (customers)",
    "baseUrl": "http://localhost:5100/a",
    "authProfileId": "service-a-basic",
    "timeoutMs": 3000,
    "openApiSource": "http://localhost:5100/a/openapi.json",
    "endpoints": [
      {
        "id": "getCustomer",
        "summary": "Get one customer",
        "method": "GET",
        "path": "/customers/{customerId}",
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responseSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "accountNo": {
              "type": "string"
            },
            "segmentCode": {
              "type": "string"
            },
            "isPremium": {
              "type": "boolean"
            }
          }
        },
        "source": "openapi"
      },
      {
        "id": "getAddresses",
        "method": "GET",
        "path": "/customers/{customerId}/addresses",
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "source": "openapi"
      }
    ]
  },
  {
    "id": "service-b",
    "name": "Service B (orders)",
    "baseUrl": "http://localhost:5100/b",
    "authProfileId": "service-b-session",
    "timeoutMs": 3000,
    "endpoints": [
      {
        "id": "getOrders",
        "method": "GET",
        "path": "/orders",
        "parameters": [
          {
            "name": "X-Customer-Id",
            "in": "header",
            "required": true,
            "type": "string"
          },
          {
            "name": "account",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer"
          }
        ],
        "source": "manual"
      },
      {
        "id": "getOrderLines",
        "method": "GET",
        "path": "/orders/{orderId}/lines",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "source": "manual"
      }
    ]
  },
  {
    "id": "service-c",
    "name": "Service C (recommendations)",
    "baseUrl": "http://localhost:5100/c",
    "authProfileId": "service-c-oauth",
    "timeoutMs": 2000,
    "endpoints": [
      {
        "id": "getRecommendations",
        "method": "GET",
        "path": "/recommendations",
        "parameters": [
          {
            "name": "segment",
            "in": "query",
            "required": true,
            "type": "string"
          },
          {
            "name": "X-Tier",
            "in": "header",
            "required": false,
            "type": "string"
          }
        ],
        "source": "manual"
      }
    ]
  }
]