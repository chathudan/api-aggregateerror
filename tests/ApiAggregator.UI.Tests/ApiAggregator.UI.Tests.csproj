<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Admin UI journeys in a real browser (Playwright, ADR 0013). The fixture runs the BUILT mocks, gateway
    and admin app as separate processes on free ports, over a temporary copy of samples/config, so the repo never changes.
    Browsers are installed once with scripts/install-playwright.sh; without them every test here is skipped.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built first, but not referenced: the tests start them as processes. -->
    <ProjectReference Include="../../samples/MockServices/MockServices.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/ApiAggregator.Gateway/ApiAggregator.Gateway.csproj" ReferenceOutputAssembly="false" />
    <!-- Referenced as well (not only built): plain unit tests of its form models run without a browser. -->
    <ProjectReference Include="../../src/ApiAggregator.Admin/ApiAggregator.Admin.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
