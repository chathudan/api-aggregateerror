# One public port for the Vercel demo: the gateway's paths go to the gateway, everything else to the admin app.
{
	admin off
	auto_https off
	persist_config off
	# Vercel ends HTTPS and sends X-Forwarded-Proto: https. Keep it, so the admin app knows its real address
	# (its Blazor connection is only accepted from a page on that same address).
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:8080} {
	@gateway path /bff /bff/* /dev/token /health/* /_admin/*
	handle @gateway {
		reverse_proxy 127.0.0.1:5200
	}
	handle {
		reverse_proxy 127.0.0.1:5300
	}
}
