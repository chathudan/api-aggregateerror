{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ApiAggregator": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "None",
      "ModelContextProtocol": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LiveLogs": {
    "Enabled": true,
    "Capacity": 2000
  },
  "Aggregator": {
    "Config": {
      "Directory": "../../config",
      "ReloadCheckSeconds": 1
    }
  },
  "Auth": {
    "Authority": "",
    "Audience": "api-aggregator",
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "RoleClaim": "roles",
      "Scopes": ""
    }
  },
  "Admin": {
    "RequireTestBeforePublish": true,
    "OpenApiAllowedHosts": []
  },
  "Gateway": {
    "BaseUrl": "http://localhost:5200/",
    "Cors": {
      "AllowedOrigins": [],
      "AllowedOriginPatterns": [],
      "PreflightMaxAgeSeconds": 600
    }
  },
  "Docs": { "BaseUrl": "https://github.com/chathudan/api-aggregateerror/blob/main/docs/guides/" }
}
