@page "/"
@using ApiAggregator.Engine.Logging.Live
@inject AdminService Admin
@inject CurrentUser User
@inject LiveLogClient Logs
@inject ToastService Toasts
@inject IConfiguration Config

<PageShell Title="Home" Purpose="What's running and what needs your attention." HelpTopic="start">
    <Actions>
        <a class="button" href="/services?add=1">Add service</a>
        <a class="button" href="@DocsUrl" target="_blank" rel="noopener">Open API docs <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
        <a class="button primary" href="/endpoints/new">Create endpoint</a>
    </Actions>
    <ChildContent>
        <div class="dashboard">
            @* ---------------------------------------------------------------- services and their sign-in *@
            <section class="card" aria-labelledby="services-heading">
                <div class="header-row">
                    <h2 id="services-heading">Services <HelpLink Topic="sign-in" /></h2>
                    <button class="button" disabled="@_checking" @onclick="CheckAll">@(_checking ? "Checking…" : "Check all sign-ins")</button>
                </div>
                @if (_services is null)
                {
                    <Loading />
                }
                else if (_services.Count == 0)
                {
                    <p class="muted">No services yet. <a href="/services?add=1">Add the first one</a>: an OpenAPI spec address is all you need to start.</p>
                }
                else
                {
                    <ul class="rows">
                        @foreach (var s in _services.OrderBy(s => s.Name))
                        {
                            var (state, text, message, when) = SignIn(s);
                            <li>
                                <a class="grow" href="/services#service-@s.Id">@(string.IsNullOrEmpty(s.Name) ? s.Id : s.Name)</a>
                                <span class="muted">@when</span>
                                <StatusPill State="state" Text="@text" Title="@message" />
                            </li>
                            @if (state == StatusPill.Kind.Bad) { <li class="sub"><span class="muted">@message</span> <HelpLink Topic="troubleshooting" Text="How do I fix this?" /></li> }
                        }
                    </ul>
                    <p class="hint">
                        <strong>Signed in</strong>: the gateway logged in or got a token.
                        <strong>Ready</strong>: settings are complete, and the service checks them on the first real call.
                    </p>
                }
            </section>

            @* ---------------------------------------------------------------- endpoints *@
            <section class="card" aria-labelledby="endpoints-heading">
                <div class="header-row">
                    <h2 id="endpoints-heading">Endpoints</h2>
                    <a href="/endpoints">All endpoints</a>
                </div>
                @if (_recipes is null)
                {
                    <Loading />
                }
                else
                {
                    <p class="counts">
                        <span><strong>@_recipes.Count(r => r.PublishedVersion is not null)</strong> live</span>
                        <span><strong>@_recipes.Count(r => r.HasDraft)</strong> with unpublished changes</span>
                        <span><strong>@_recipes.Count(r => r.Deleted)</strong> deleted</span>
                    </p>
                    @if (_recipes.All(r => r.Deleted))
                    {
                        <p class="muted">Nothing built yet. <a href="/endpoints/new">Create your first endpoint</a>.</p>
                    }
                    else
                    {
                        <ul class="rows">
                            @foreach (var r in _recipes.Where(r => !r.Deleted).OrderByDescending(r => r.HasDraft).ThenBy(r => r.Name).Take(8))
                            {
                                <li>
                                    <a class="grow" href="/endpoints/@r.Id">@(string.IsNullOrEmpty(r.Name) ? r.Id : r.Name)</a>
                                    @if (r.PublishedVersion is { } v) { <StatusPill State="StatusPill.Kind.Ok" Text="@($"Live v{v}")" /> }
                                    else { <StatusPill State="StatusPill.Kind.Neutral" Text="Not published" /> }
                                    @if (r.HasDraft) { <StatusPill State="StatusPill.Kind.Info" Text="Unpublished changes" /> }
                                </li>
                            }
                        </ul>
                    }
                }
            </section>
        </div>

        @* ---------------------------------------------------------------- recent warnings and errors *@
        <section class="card" aria-labelledby="problems-heading">
            <div class="header-row">
                <h2 id="problems-heading">Recent warnings and errors <HelpLink Topic="logs" /></h2>
                <a href="/logs?level=warn">Open logs</a>
            </div>
            @if (_problems is null)
            {
                <Loading Text="Reading the latest log lines…" />
            }
            else if (_problems.Count == 0)
            {
                <p class="muted">@(_logError ?? "Nothing to look at: no warnings or errors in the latest log lines.")</p>
            }
            else
            {
                <table class="list">
                    <caption class="visually-hidden">The latest warnings and errors from the gateway and the admin app</caption>
                    <thead><tr><th scope="col">Time</th><th scope="col">Level</th><th scope="col">Where</th><th scope="col">Code</th><th scope="col">What happened</th><th scope="col"><span class="visually-hidden">Logs</span></th></tr></thead>
                    <tbody>
                        @foreach (var (source, e) in _problems)
                        {
                            <tr>
                                <td class="nowrap">@e.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td>
                                    @if (e.Level is "Error" or "Critical") { <StatusPill State="StatusPill.Kind.Bad" Text="Error" /> }
                                    else { <StatusPill State="StatusPill.Kind.Warn" Text="Warning" /> }
                                </td>
                                <td>@source@(e.RecipeId is null ? "" : $" · {e.RecipeId}")@(e.ServiceId is null ? "" : $" · {e.ServiceId}")</td>
                                <td>@if (e.ErrorCode is not null) { <code>@e.ErrorCode</code> }</td>
                                <td>@Shorten(e.Message)</td>
                                <td class="nowrap">
                                    @if (e.CorrelationId is not null) { <a href="/logs?correlation=@Uri.EscapeDataString(e.CorrelationId)">See this request</a> }
                                    else { <a href="/logs?level=warn">See logs</a> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_logError is not null) { <p class="hint">@_logError</p> }
            }
        </section>
    </ChildContent>
</PageShell>

@code {
    private List<ApiService>? _services;
    private List<SignInStatus> _signIns = [];
    private AdminActor _me = AdminActor.Anonymous;
    private List<RecipeSummary>? _recipes;
    private List<(string Source, LiveLogEntry Entry)>? _problems;
    private string? _logError;
    private bool _checking;

    private string DocsUrl => (Config["Gateway:BaseUrl"] ?? "http://localhost:5200/").TrimEnd('/') + "/bff/docs";

    protected override async Task OnInitializedAsync()
    {
        // Independent calls: start them together.
        _me = await User.ActorAsync();
        var services = Admin.GetServicesAsync(_me).ValueAsync();
        var signIns = Admin.GetSignInStatusAsync(_me).ValueAsync();
        var recipes = Admin.GetRecipesAsync(_me).ValueAsync();
        var problems = LoadProblems();

        _services = (await services)?.ToList() ?? [];
        _signIns = (await signIns)?.ToList() ?? [];
        _recipes = (await recipes)?.ToList() ?? [];
        await problems;
    }

    /// <summary>The newest warnings and errors from both processes (from their in-memory live logs).</summary>
    private async Task LoadProblems()
    {
        var found = new List<(string, LiveLogEntry)>();
        var unreachable = new List<string>();
        foreach (var source in new[] { LogSource.Gateway, LogSource.Admin })
        {
            var (page, _) = await Logs.ReadAsync(source, after: 0, waitSeconds: 0, CancellationToken.None);
            if (page is null) { unreachable.Add(source == LogSource.Gateway ? "the gateway" : "the admin app"); continue; }
            found.AddRange(page.Entries.Where(e => e.Level is "Warning" or "Error" or "Critical").Select(e => (page.Source, e)));
        }
        _problems = found.OrderByDescending(p => p.Item2.Timestamp).Take(6).ToList();
        _logError = unreachable.Count == 0 ? null : $"Couldn't read the logs of {string.Join(" and ", unreachable)}. Is it running?";
    }

    private async Task CheckAll()
    {
        _checking = true;
        var result = await Admin.CheckAllSignInsAsync(_me).ValueAsync();
        _checking = false;
        if (result is null) { Toasts.Error("Couldn't check the sign-ins. Try again.", "See logs", "/logs?level=warn"); return; }

        _signIns = result.ToList();
        var failed = result.Count(r => r.State == SignInState.Failed);
        if (failed == 0) Toasts.Success("Every sign-in works, or is ready for its first call.");
        else Toasts.Error($"{failed} sign-in{(failed == 1 ? "" : "s")} failed. The services list shows which and why.");
    }

    /// <summary>The pill for a service: from the last check of its sign-in, in words as well as colour.</summary>
    private (StatusPill.Kind State, string Text, string Message, string When) SignIn(ApiService s)
    {
        var d = SignInDisplay.For(s, _signIns);
        return (d.State, d.Text, d.Message, SignInDisplay.Ago(d.CheckedAt));
    }

    private static string Shorten(string message) => message.Length <= 140 ? message : message[..140] + "…";
}
