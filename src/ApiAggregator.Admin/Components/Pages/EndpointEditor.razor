@page "/endpoints/new"
@page "/endpoints/{Id}"
@using System.Text.RegularExpressions
@using Microsoft.JSInterop
@using ApiAggregator.Engine.Planning
@inject AdminService Admin
@inject CurrentUser User
@inject NavigationManager Nav
@inject IConfiguration Config
@inject ToastService Toasts
@inject UiContext Ui
@inject IJSRuntime JS

@if (_snapshot is null)
{
    <PageShell Title="Endpoint" Crumbs="Crumbs"><Loading /></PageShell>
    return;
}

@* Ask before leaving with unsaved changes: for links inside the admin UI, and for closing or reloading the tab. *@
<NavigationLock OnBeforeInternalNavigation="OnBeforeLeave" ConfirmExternalNavigation="@IsDirty" />

<PageShell Title="@(IsNew ? "New endpoint" : (string.IsNullOrWhiteSpace(_form.Name) ? _form.Id : _form.Name))" Crumbs="Crumbs"
           Purpose="Build, test and publish one aggregated endpoint." HelpTopic="build" />
<p class="muted">Address callers use: <code>@_form.Method /bff/@_form.Route.Trim('/')</code></p>

@* ---- stepper: each step links to its section and says what's left to do there *@
<nav aria-label="Steps">
    <ol class="stepper">
        @foreach (var (number, title, anchor, done, state) in Steps())
        {
            <li class="@(done ? "done" : state.StartsWith("✕") ? "todo" : "")">
                <a href="@($"{Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0]}#{anchor}")">
                    <span class="num" aria-hidden="true">@(done ? "✓" : number.ToString())</span>
                    <span>@title</span>
                    <span class="state">@state</span>
                </a>
            </li>
        }
    </ol>
</nav>

@if (_deleted)
{
    <div class="issues warnings">
        <strong>This endpoint is deleted.</strong> The gateway doesn't serve it. Its last version is shown below.
        To bring it back, choose <strong>Roll back to this</strong> under <a href="#history">History</a>, or change it, test it and publish. <HelpLink Topic="history" />
    </div>
}

@* ------------------------------------------------------------------ 1. Endpoint *@
<section class="card" id="step-1">
    <h2>1. Endpoint</h2>
    <div class="grid">
        <label>Name <input value="@_form.Name" @onchange="e => OnNameChanged(e.Value?.ToString())" placeholder="Customer overview" /></label>
        <label>Id <input @bind="_form.Id" disabled="@(!IsNew)" placeholder="customer-overview" /></label>
        <label>Method
            <select @bind="_form.Method">
                @foreach (var m in new[] { "GET", "POST", "PUT", "PATCH", "DELETE" }) { <option>@m</option> }
            </select>
        </label>
        <label>Route <input value="@_form.Route" @onchange="e => OnRouteChanged(e.Value?.ToString())" placeholder="customer/{id}/overview" /></label>
    </div>
    <FieldIssues Problems="@ProblemsWhere(IsEndpointField)" Warnings="@WarningsWhere(IsEndpointField)" />
    <div class="grid">
        <label class="check"><input type="checkbox" @bind="_form.RequireAuthentication" /> Callers must sign in</label>
        <label>Required scope <input @bind="_form.RequiredScope" placeholder="customer.read" /></label>
        <label class="check"><input type="checkbox" @bind="_form.CacheEnabled" /> Cache responses</label>
        @if (_form.CacheEnabled)
        {
            <label>Keep for (seconds) <input type="number" min="1" max="86400" @bind="_form.CacheTtlSeconds" /></label>
        }
    </div>
    @if (_form.CacheEnabled && _form.CachePerCaller) { <p class="hint">Each caller gets their own cached copy, so nobody can see another person's data.</p> }
    @if (_form.CacheEnabled && !_form.CachePerCaller)
    {
        @* Set in the recipe file (the wizard doesn't offer it). Kept as it is, but never hidden. *@
        <p class="issues warnings"><strong>One cached copy is shared by every caller.</strong> This recipe says <code>perCaller: false</code>. That's only safe for data that is the same for everyone, never for customer or patient data.</p>
    }
</section>

@* ------------------------------------------------------------------ 2. Inputs *@
<section class="card" id="step-2">
    <h2>2. Inputs <HelpLink Topic="build" /></h2>
    <p class="hint">What the caller sends. Anything not listed here is ignored and never passed on.</p>
    @if (_form.Inputs.Count > 0)
    {
        <table class="list">
            <thead><tr><th scope="col">From</th><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Required</th><th scope="col">Default</th><th scope="col">Test value</th><th scope="col"><span class="visually-hidden">Remove</span></th></tr></thead>
            <tbody>
                @foreach (var input in _form.Inputs)
                {
                    <tr>
                        <td>
                            <select @bind="input.Source" aria-label="Where the value comes from">
                                <option value="route">route</option><option value="query">query</option><option value="header">header</option>
                            </select>
                        </td>
                        <td><input @bind="input.Name" aria-label="Input name" /></td>
                        <td>
                            <select @bind="input.Type" aria-label="Type">
                                @foreach (var t in new[] { "string", "int", "number", "bool", "date" }) { <option>@t</option> }
                            </select>
                        </td>
                        <td><input type="checkbox" @bind="input.Required" aria-label="Required" /></td>
                        <td><input @bind="input.Default" aria-label="Default value" /></td>
                        <td><input @bind="input.TestValue" placeholder="for Try it" aria-label="Test value for Try it" /></td>
                        <td><button class="link" @onclick="() => _form.Inputs.Remove(input)">Remove<span class="visually-hidden"> input @input.Name</span></button></td>
                    </tr>
                    @if (ProblemsWhere(w => w == $"inputs.{input.Source}.{input.Name}") is { Count: > 0 } inputProblems)
                    {
                        <tr><td colspan="7"><FieldIssues Problems="inputProblems" /></td></tr>
                    }
                }
            </tbody>
        </table>
    }
    @if (_form.Inputs.Count == 0) { <p class="muted">No inputs yet. Values in the route, such as <code>{id}</code>, are added here for you as you type the route.</p> }
    <FieldIssues Problems="@ProblemsWhere(w => w == "inputs")" />
    <button class="button" @onclick="() => _form.Inputs.Add(new InputForm())">Add input</button>
</section>

@* ------------------------------------------------------------------ 3. Steps *@
<section class="card" id="step-3">
    <h2>3. Steps <HelpLink Topic="build" /></h2>
    <p class="hint">Each step calls one service endpoint. Fill each value from the caller's inputs or from an earlier step. The run order is worked out for you.</p>
    @if (_form.Steps.Count > 1 && TryRecipe() is { } planned) { <StepFlow Recipe="planned" Snapshot="_snapshot" /> }
    <FieldIssues Problems="@ProblemsWhere(w => w == "steps")" />

    @for (var i = 0; i < _form.Steps.Count; i++)
    {
        var step = _form.Steps[i];
        var number = i + 1;
        <div class="step">
            <div class="header-row">
                <input class="step-name" aria-label="Step name" value="@step.DisplayName" @onchange="e => OnStepNameChanged(step, e.Value?.ToString())" />
                <button class="link" @onclick="() => _form.Steps.Remove(step)">Remove step<span class="visually-hidden"> @step.DisplayName</span></button>
            </div>
            @* The name used inside expressions: shown for anyone writing a custom one, kept in step with the display name. *@
            <p class="alias-line muted">Name in expressions: <code data-alias>@step.Alias</code>
                <button class="link" @onclick="() => CopyAlias(step)">Copy<span class="visually-hidden"> @step.Alias</span></button></p>
            @if (step.PendingAlias is { } pending)
            {
                var uses = _form.References(step.Alias);
                <ConfirmBox ConfirmText="Rename everywhere" CancelText="@($"Keep {step.Alias}")" OnConfirm="() => RenameNow(step, pending)" OnCancel="() => step.PendingAlias = null">
                    <p>Also rename it to <code>@pending</code> in expressions?
                        @(uses == 0 ? "Nothing in this endpoint uses it yet." : $"{uses} place{(uses == 1 ? "" : "s")} in this endpoint use{(uses == 1 ? "s" : "")} it, and they're all updated.")
                        @if (IsLive)
                        {
                            <span>Apps calling the live endpoint will see the new name once you publish: in error details (<code>errors[].step</code>, <code>_errors[].step</code>)@(_form.Response.Count == 0 && _form.RawResponse is null ? ", and as a field name in the answer, because it has no response fields" : "").</span>
                        }
                    </p>
                </ConfirmBox>
            }
            @if (step.RenameProblem is { } renameProblem)
            {
                <ul class="field-issues"><li class="problem"><span aria-hidden="true">✕</span><span class="visually-hidden">Problem: </span>@renameProblem</li></ul>
            }
            <FieldIssues Problems="@StepProblems(step)" Warnings="@WarningsWhere(w => w == $"steps.{step.Alias}")" />

            <label>Calls
                <select value="@step.Endpoint" @onchange="e => OnEndpointChanged(step, e.Value?.ToString())">
                    <option value="">Pick a service endpoint…</option>
                    @foreach (var s in _snapshot.Services.OrderBy(s => s.Name))
                    {
                        <optgroup label="@s.Name">
                            @foreach (var ep in s.Endpoints) { <option value="@($"{s.Id}/{ep.Id}")">@ep.Method @ep.Path @(ep.Summary is null ? "" : $"· {ep.Summary}")</option> }
                        </optgroup>
                    }
                </select>
            </label>

            <LoopPicker Step="step" Options="LoopsFor(step)" Changed="() => OnLoopChanged(step)" />

            @if (step.Bindings.Count > 0)
            {
                var sources = SourcesFor(step);
                <table class="list bindings">
                    <thead><tr><th>Value</th><th>Sent as</th><th>Use value from</th></tr></thead>
                    <tbody>
                        @foreach (var (target, binding) in step.Bindings.OrderBy(b => b.Key))
                        {
                            var parts = target.Split('.', 2);
                            <tr>
                                <td>@parts[1]</td>
                                <td><span class="tag">@parts[0]</span></td>
                                <td>
                                    @if (binding.Suggested) { <span class="tag suggested" title="@binding.Reason">suggested</span> }
                                    <select value="@SelectValue(binding)" aria-label="@($"Value for {parts[1]} ({parts[0]})")" @onchange="e => OnBindingChanged(binding, e.Value?.ToString())">
                                        <option value="none">Leave empty</option>
                                        @foreach (var group in sources.GroupBy(o => o.Group))
                                        {
                                            <optgroup label="@group.Key">
                                                @foreach (var o in group) { <option value="@($"src:{o.Expression}")">@o.Label</option> }
                                            </optgroup>
                                        }
                                        @* A value the field list doesn't know (the service has no response schema): show it rather than a blank box. *@
                                        @if (binding.Mode == BindingMode.FromSource && !sources.Any(o => o.Expression == binding.Expression))
                                        {
                                            <option value="@($"src:{binding.Expression}")">@binding.Expression (not in the field list)</option>
                                        }
                                        <option value="fixed">Fixed value…</option>
                                    </select>
                                    @if (binding.Mode == BindingMode.FixedValue)
                                    {
                                        <input @bind="binding.FixedValue" placeholder="@(binding.FixedIsJson ? "JSON value" : "Type the value")" aria-label="@($"Fixed value for {parts[1]}")" />
                                    }
                                    @if (NeedsLoop(step, binding))
                                    {
                                        <p class="hint loop-first">Choose what to loop over first: under <strong>Run this step</strong>, pick <strong>Once for each item in a list</strong>.</p>
                                    }
                                    <FieldIssues Problems="@BindingProblems(step, target)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="inline">
                    <input @bind="_extraTarget[number]" placeholder="header.X-Something or query.name" aria-label="Another value to send: where it goes" />
                    <button class="link" @onclick="() => AddExtraValue(step, number)">Add another value</button>
                </div>
            }

            @if (RunsAfter(step) is { Length: > 0 } after) { <p class="hint">Runs after @after.</p> }

            <button class="link" @onclick="() => step.ShowAdvanced = !step.ShowAdvanced">@(step.ShowAdvanced ? "Hide advanced" : "Advanced")</button>
            @if (step.ShowAdvanced)
            {
                <div class="grid">
                    <label class="check"><input type="checkbox" @bind="step.Required" /> If this call fails, fail the whole endpoint</label>
                    <label class="check"><input type="checkbox" @bind="step.CacheEnabled" /> Cache this call</label>
                    @if (step.CacheEnabled) { <label>Keep for (seconds) <input type="number" min="1" @bind="step.CacheTtlSeconds" /></label> }
                </div>
                @if (step.CacheEnabled && !step.CachePerCaller)
                {
                    <p class="issues warnings"><strong>This call's cached answer is shared by every caller</strong> (<code>perCaller: false</code> in the recipe). Only safe for data that is the same for everyone.</p>
                }
                <ConditionPicker Step="step" Fields="SourcesFor(step)" />
            }
        </div>
    }
    @if (!_picking)
    {
        <button class="button" @onclick="() => { _picking = true; _search = string.Empty; }">Add step</button>
    }
    else
    {
        <div class="picker">
            <div class="inline">
                <input class="grow" @bind="_search" @bind:event="oninput" placeholder="Search endpoints, e.g. orders" />
                <button class="link" @onclick="() => _picking = false">Close</button>
            </div>
            @foreach (var s in _snapshot.Services.OrderBy(s => s.Name))
            {
                var matches = s.Endpoints.Where(e => Matches(s, e)).ToList();
                if (matches.Count == 0) continue;
                <h3>@s.Name</h3>
                @foreach (var ep in matches)
                {
                    <div class="picker-row">
                        <div><strong>@(ep.Summary ?? Slug.Humanize(ep.Id))</strong> <code class="muted">@ep.Method @ep.Path</code></div>
                        <button class="button" @onclick="() => AddStep(s, ep)">Add</button>
                    </div>
                }
            }
            @if (_snapshot.Services.All(s => s.Endpoints.Count == 0)) { <p class="muted">No endpoints yet. <a href="/services">Add a service</a> first.</p> }
        </div>
    }
    @if (_form.Steps.Count > 0) { <p class="hint">Values marked <span class="tag suggested">suggested</span> were filled in for you. Check them, then try it in step 5.</p> }
</section>

@* ------------------------------------------------------------------ 4. Response *@
<section class="card" id="step-4">
    <h2>4. Response</h2>

    @* ---- combine lists: merge records that appear in several services *@
    <div class="combine-card">
        <div class="header-row"><h3>Combine lists <HelpLink Topic="combine" /></h3></div>
        <p class="hint">Do the same records (for example customers) come back from more than one service? Combine them into one list with each record once. Then add the result to the response below.</p>
        @{ var lists = ListOptions.For(_form, _snapshot); }
        @foreach (var combine in _form.Combines.ToList())
        {
            <CombineEditor Form="combine" Lists="lists" Changed="StateHasChanged" Removed="() => _form.Combines.Remove(combine)" AddToResponse="() => AddCombineToResponse(combine)" />
        }
        <FieldIssues Problems="@ProblemsWhere(w => w.StartsWith("combine"))" Warnings="@WarningsWhere(w => w.StartsWith("combine"))" />
        <button class="button" disabled="@(_form.Steps.Count == 0)" @onclick="AddCombine">Combine lists</button>
        @if (_form.Steps.Count == 0) { <span class="hint">Add steps first.</span> }
    </div>

    <h3>Response fields</h3>
    <FieldIssues Problems="@ProblemsWhere(w => w == "response")" Warnings="@WarningsWhere(w => w == "response")" />
    <p class="hint">Choose what the caller gets back. With no fields, each step's full response (and each combined list) is returned under its name. Once you add a field, only the fields listed here are returned.</p>
    @if (_form.RawResponse is not null)
    {
        <p class="hint">This endpoint's response is written by hand as <code>@_form.RawResponse.ToJsonString()</code>, so it's kept exactly as it is.
            <button class="link" @onclick="() => _form.RawResponse = null">Replace it with fields</button></p>
    }
    else
    {
    var allSources = SourcesFor(null);
    <table class="list">
        <thead><tr><th>Field name</th><th>Value</th><th></th></tr></thead>
        <tbody>
            @foreach (var field in _form.Response)
            {
                <tr>
                    <td><input @bind="field.Name" aria-label="Field name" /></td>
                    <td>
                        @if (field.Raw is not null)
                        {
                            @* Text around a value, a number or a nested object: kept exactly as written in the recipe. *@
                            <code>@field.Raw.ToJsonString()</code>
                            <button class="link" @onclick="() => field.Raw = null">Pick a value instead<span class="visually-hidden"> for @field.Name</span></button>
                        }
                        else
                        {
                        <select @bind="field.Expression" aria-label="@($"Value of {field.Name}")">
                            <option value="">Pick a value…</option>
                            @foreach (var o in allSources) { <option value="@o.Expression">@o.Label</option> }
                            @if (!string.IsNullOrEmpty(field.Expression) && !allSources.Any(o => o.Expression == field.Expression))
                            {
                                <option value="@field.Expression">@field.Expression (not in the field list)</option>
                            }
                        </select>
                        }
                    </td>
                    <td><button class="link" @onclick="() => _form.Response.Remove(field)">Remove</button></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="inline">
        @foreach (var step in _form.Steps)
        {
            <button class="button" @onclick="() => AddFieldsFrom(step)">Add fields from @step.DisplayName</button>
        }
        <button class="link" @onclick="() => _form.Response.Add(new ResponseField())">Add one field</button>
        @if (_form.Response.Count > 0) { <button class="link" @onclick="() => { _form.Response.Clear(); _form.EmptyResponseObject = false; }">Clear (return everything)</button> }
    </div>
    }
</section>

@* ------------------------------------------------------------------ 5. Test and publish *@
<section class="card" id="step-5">
    <h2>5. Test and publish <HelpLink Topic="publish" /></h2>
    <p class="hint">Enter test values next to the inputs in step 2, then choose <strong>Try it</strong> below. Publishing needs a passing test of exactly these settings.</p>

    @if (Issues.Count > 0)
    {
        <div class="issues">
            <strong>Things to fix</strong> <HelpLink Topic="troubleshooting" Text="What do these mean?" />
            <ul>@foreach (var issue in Issues) { <li><a href="@SectionLink(SectionOf(issue.Where))">@SectionTitle(issue.Where)</a>: @issue.Message</li> }</ul>
        </div>
    }

    @if (Warnings.Count > 0)
    {
        <div class="issues warnings">
            <strong>Check before publishing</strong>
            <ul>@foreach (var warning in Warnings) { <li><a href="@SectionLink(SectionOf(warning.Where))">@SectionTitle(warning.Where)</a>: @warning.Message</li> }</ul>
        </div>
    }

    <ErrorBanner Message="@_error" CorrelationId="@_errorCorrelation" HelpTopic="troubleshooting" OnClose="() => _error = null" />

    @if (_test is not null)
    {
        <p role="status">
            <StatusPill State="@(_test.Passed ? StatusPill.Kind.Ok : StatusPill.Kind.Bad)" Text="@(_test.Passed ? "Test passed" : "Test didn't pass")" />
            @if (_test.StatusCode is { } status)
            {
                <span>HTTP @status · @_test.DurationMs ms @(_test.Partial == true ? "· partial response (an optional call failed)" : "")</span>
            }
            else
            {
                <span>Not run: fix the problems under Things to fix first.</span>
            }
        </p>
        @if (!string.IsNullOrEmpty(_test.CorrelationId))
        {
            <p class="hint"><a href="/logs?correlation=@Uri.EscapeDataString(_test.CorrelationId)">See logs for this test</a>
                @if (!_test.Passed) { <HelpLink Topic="troubleshooting" Text="What do these errors mean?" /> }</p>
        }
        @if (_test.Trace is { Count: > 0 })
        {
            <table class="list">
                <thead><tr><th>Step</th><th>Result</th><th>Status</th><th>Time</th><th>Call</th><th>Note</th></tr></thead>
                <tbody>
                    @foreach (var t in _test.Trace)
                    {
                        <tr>
                            <td>@(t.DisplayName ?? t.Alias)</td><td>@t.Outcome.ToString().ToLowerInvariant()</td><td>@t.HttpStatus</td><td>@t.DurationMs ms</td>
                            <td><code>@t.Request</code> @(t.Calls > 1 ? $"×{t.Calls}" : "")</td><td>
                                @t.Message
                                @if (t.Detail is not null) { <span> — @t.Detail</span> }
                                @if (t.ErrorCode is not null) { <span class="tag" title="@(t.Retryable ? "Worth trying again later" : "Trying again won't help")">@t.ErrorCode</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (_test.Body is not null) { <pre class="json">@_test.Body.ToJsonString(new JsonSerializerOptions { WriteIndented = true })</pre> }
    }

</section>

@* ------------------------------------------------------------------ History, discard, delete *@
@if (!IsNew)
{
    <section class="card" id="history">
        <h2>History <HelpLink Topic="history" /></h2>
        @if (_history is null)
        {
            <Loading Text="Loading the history…" />
        }
        else if (_history.Count == 0)
        {
            <p class="muted">
                @if (_liveVersion is { } live)
                {
                    <span>v@(live) is live, but it was added straight to the config files, so it has no history yet. The next publish starts it.</span>
                }
                else
                {
                    <span>Not published yet. Every version you publish is kept here, so you can look at it or go back to it later.</span>
                }
            </p>
        }
        else
        {
            <table class="list">
                <thead><tr><th>Version</th><th>What happened</th><th>When</th><th>Who</th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in _history)
                    {
                        <tr>
                            <td>v@(row.Version) @if (row.IsLive) { <span class="tag live">live</span> }</td>
                            <td>@Describe(row)</td>
                            <td>@When(row.At)</td>
                            <td>@Who(row)</td>
                            <td>
                                @if (row.Action != HistoryAction.Unpublished)
                                {
                                    <button class="link" @onclick="() => ToggleView(row.Version)">@(_viewing == row.Version ? "Hide" : "View")</button>
                                    @if (_caps.CanPublish && !row.IsLive)
                                    {
                                        <text> · </text><button class="link" @onclick="() => { _confirmRollBack = row.Version; _confirm = Confirm.None; }">Roll back to this</button>
                                    }
                                }
                            </td>
                        </tr>
                        @if (_viewing == row.Version && _viewed is { } v)
                        {
                            <tr><td colspan="5">
                                <div class="history-view">
                                    <p><strong>@(string.IsNullOrEmpty(v.Name) ? v.Id : v.Name)</strong> · <code>@v.Method /bff/@v.Route</code> · @(v.RequireAuthentication ? $"sign-in required{(string.IsNullOrEmpty(v.RequiredScope) ? "" : $", scope {v.RequiredScope}")}" : "no sign-in")</p>
                                    <p class="hint">Steps: @string.Join(", ", v.Steps.Select(st => $"{st.DisplayName ?? st.Alias} ({st.Endpoint})"))@(v.Combine.Count > 0 ? $" · combined lists: {string.Join(", ", v.Combine.Keys)}" : "")</p>
                                    <pre class="json">@JsonSerializer.Serialize(v, AggregatorJson.Options)</pre>
                                </div>
                            </td></tr>
                        }
                        @if (_confirmRollBack == row.Version)
                        {
                            <tr><td colspan="5">
                                <ConfirmBox ConfirmText="@($"Roll back to v{row.Version}")" OnConfirm="() => RollBack(row.Version)" OnCancel="() => _confirmRollBack = null">
                                    <p>Version @row.Version goes live again as a <strong>new</strong> version, v@(NextVersion). Callers get it within a few seconds. Nothing in the history is removed@(_hasDraft ? ", and your unpublished changes are kept" : "").</p>
                                </ConfirmBox>
                            </td></tr>
                        }
                    }
                </tbody>
            </table>
            @if (!_caps.CanPublish) { <p class="hint">Only publishers can roll back or delete an endpoint. Ask a publisher if you need one of those.</p> }
        }

        @if (_hasDraft || (_liveVersion is not null && _caps.CanPublish))
        {
            <div class="danger-zone">
                <h3>Discard or delete <HelpLink Topic="delete" /></h3>
                <div class="inline">
                    @if (_hasDraft) { <button class="button" @onclick="() => { _confirm = Confirm.Discard; _confirmRollBack = null; }">Discard unpublished changes</button> }
                    @if (_caps.CanPublish && (_liveVersion is not null || _hasDraft)) { <button class="button" @onclick="() => { _confirm = Confirm.Delete; _confirmRollBack = null; }">Delete endpoint</button> }
                </div>
                @if (_confirm == Confirm.Discard)
                {
                    <ConfirmBox ConfirmText="Discard changes" OnConfirm="DiscardDraft" OnCancel="() => _confirm = Confirm.None">
                        @if (_liveVersion is { } live)
                        {
                            <p>Your unpublished changes are removed. The live version, v@(live), keeps serving and opens here.</p>
                        }
                        else
                        {
                            <p>This endpoint was never published@(_history?.Count > 0 ? " since it was deleted" : ""), so the whole draft is removed.</p>
                        }
                    </ConfirmBox>
                }
                @if (_confirm == Confirm.Delete)
                {
                    <ConfirmBox Danger="true" ConfirmText="Delete endpoint" OnConfirm="DeleteEndpoint" OnCancel="() => _confirm = Confirm.None">
                        <p>
                            @if (_liveVersion is not null)
                            {
                                <span>The gateway stops serving <code>@_form.Method /bff/@_form.Route.Trim('/')</code> within a few seconds. Apps that still call it get <strong>404 not_found</strong>. </span>
                            }
                            @if (_hasDraft) { <span>Unpublished changes are removed too. </span> }
                            The history is kept, so a publisher can restore any version later.
                        </p>
                    </ConfirmBox>
                }
            </div>
        }
    </section>
}

@* ------------------------------------------------------------------ leaving with unsaved changes *@
@if (_pendingLeave is not null)
{
    <div class="leave-box">
        <ConfirmBox ConfirmText="Save and leave" OnConfirm="SaveAndLeave" OnCancel="() => _pendingLeave = null">
            <p><strong>You have unsaved changes.</strong> Save them as a draft before you go? The live endpoint doesn't change either way.</p>
            <button class="button" @onclick="LeaveWithoutSaving">Leave without saving</button>
        </ConfirmBox>
    </div>
}

@* ------------------------------------------------------------------ always-visible actions *@
<div class="sticky-footer" role="region" aria-label="Save, test and publish">
    <div class="summary">
        @if (IsDirty) { <StatusPill State="StatusPill.Kind.Warn" Text="Unsaved changes" /> }
        else if (IsNew && !_everSaved) { <StatusPill State="StatusPill.Kind.Neutral" Text="Not saved yet" /> }
        else { <StatusPill State="StatusPill.Kind.Ok" Text="All changes saved" /> }
        @if (Issues.Count > 0) { <a href="@SectionLink(FirstProblemAnchor)">@Issues.Count problem@(Issues.Count == 1 ? "" : "s") to fix</a> }
        else if (ShowProblems) { <span class="muted">No problems found</span> }
        @if (TestedCurrent) { <StatusPill State="StatusPill.Kind.Ok" Text="Test passed" /> }
        else if (_test is { Passed: false }) { <StatusPill State="StatusPill.Kind.Bad" Text="Test didn't pass" /> }
    </div>
    <button class="button" disabled="@_busy" @onclick="SaveDraftClicked">Save draft</button>
    @* One primary button: Try it until a test passes, then Publish. *@
    <button class="button @(TestedCurrent && _caps.CanPublish ? "" : "primary")" disabled="@_busy" @onclick="RunTest">@(_busy && _running ? "Trying…" : "Try it")</button>
    @if (_caps.CanPublish)
    {
        <button class="button @(TestedCurrent ? "primary" : "")" disabled="@(_busy || !CanPublishNow)" title="@(CanPublishNow ? "" : "Publish needs a passing Try it of exactly these settings")" @onclick="Publish">Publish</button>
    }
    else
    {
        <span class="hint">A publisher makes it live.</span>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }

    private bool IsNew => Id is null;
    private RecipeForm _form = new();
    private ConfigSnapshot? _snapshot;
    private TestOutcome? _test;
    private string? _testedJson;          // the settings that last passed Try it
    private string? _savedJson;           // the settings as last loaded or saved (for "unsaved changes")
    private string? _error;               // shown in a banner with links to help and the logs
    private string? _errorCorrelation;
    private bool _busy, _running;
    private string? _pendingLeave;        // where the user wanted to go with unsaved changes
    private bool _leaving;
    private bool _everSaved, _saveTried;   // for a new endpoint: saved at least once / a save was tried
    private ValidationResult? _validation; // worked out once per render, not once per field
    private bool _picking;
    private string _search = "";
    private readonly Dictionary<int, string> _extraTarget = new();

    private enum Confirm { None, Discard, Delete }
    private Capabilities _caps = new(false, false, true, false, []);

    private static readonly IReadOnlyList<(string Text, string Href)> Crumbs = [("Endpoints", "/endpoints")];
    private List<HistoryRow>? _history;
    private int? _liveVersion;   // the version the gateway serves now, if any
    private bool _hasDraft;      // there are unpublished changes
    private bool _deleted;       // not live, no draft, but there is history: shown from its last version
    private int? _viewing;
    private Recipe? _viewed;
    private int? _confirmRollBack;
    private Confirm _confirm;
    private AdminActor _me = AdminActor.Anonymous;

    protected override async Task OnInitializedAsync()
    {
        _me = await User.ActorAsync();
        var services = await Admin.GetServicesAsync(_me).ValueAsync() ?? [];
        var profiles = await Admin.GetAuthProfilesAsync(_me).ValueAsync() ?? [];
        _snapshot = new ConfigSnapshot(services.ToList(), profiles.ToList(), [], "admin-ui");
        _caps = await Ui.CapabilitiesAsync();

        if (!IsNew) await LoadRecipe();
        for (var i = 1; i <= 20; i++) _extraTarget[i] = "";
        MarkSaved();
    }

    protected override void OnAfterRender(bool firstRender) => _validation = null; // re-check after the next change

    // ------------------------------------------------------------------ unsaved changes, test state

    private string? CurrentJson()
    {
        try { return JsonSerializer.Serialize(_form.ToRecipe(), AggregatorJson.Options); }
        catch (Exception) { return null; } // a half-filled form: it counts as changed
    }

    private void MarkSaved() => _savedJson = CurrentJson();

    private bool IsDirty => CurrentJson() != _savedJson;

    /// <summary>The last Try it passed, and nothing has changed since.</summary>
    private bool TestedCurrent => _test is { Passed: true } && _testedJson is not null && _testedJson == CurrentJson();

    private bool CanPublishNow => Validation.Issues.Count == 0 && (TestedCurrent || !_caps.RequireTestBeforePublish);

    private Task OnBeforeLeave(LocationChangingContext context)
    {
        if (_leaving || !IsDirty) return Task.CompletedTask;
        // Jumping to a section of this page (the stepper) isn't leaving.
        if (Nav.ToAbsoluteUri(context.TargetLocation).AbsolutePath == Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath) return Task.CompletedTask;
        context.PreventNavigation();
        _pendingLeave = context.TargetLocation;
        return Task.CompletedTask;
    }

    private async Task SaveAndLeave()
    {
        if (!await SaveDraft()) { _pendingLeave = null; return; }
        LeaveWithoutSaving();
    }

    private void LeaveWithoutSaving()
    {
        var target = _pendingLeave ?? "/";
        _pendingLeave = null;
        _leaving = true;
        Nav.NavigateTo(target);
    }

    // ------------------------------------------------------------------ the stepper and problems next to fields

    private ValidationResult Validation => _validation ??= SafeValidate();

    private ValidationResult SafeValidate()
    {
        try { return RecipeValidator.Validate(_form.ToRecipe(), _snapshot!); }
        catch (Exception ex) { return new ValidationResult([new ValidationIssue("form", ex.Message)]); }
    }

    private Recipe? TryRecipe()
    {
        try { return _form.ToRecipe(); } catch (Exception) { return null; }
    }

    private static bool IsEndpointField(string where) => where is "id" or "route" or "method" or "timeoutMs" or "form" || where.StartsWith("cache");

    private IReadOnlyList<ValidationIssue> ProblemsWhere(Func<string, bool> where) => Issues.Where(i => where(i.Where)).ToList();
    private IReadOnlyList<ValidationIssue> WarningsWhere(Func<string, bool> where) => Warnings.Where(i => where(i.Where)).ToList();

    /// <summary>Problems about one value of a step, recognised by how the validator names it: 'X-Customer-Id' (header).</summary>
    private IReadOnlyList<ValidationIssue> BindingProblems(StepForm step, string target)
    {
        var parts = target.Split('.', 2);
        return Issues.Where(i => i.Where == $"steps.{step.Alias}" &&
            (i.Message.Contains($"'{parts[1]}' ({parts[0]})") || i.Message.Contains($"'{target}'") || i.Message.Contains($"Header '{parts[1]}'"))).ToList();
    }

    /// <summary>A step's problems that aren't about one of its values (those are shown next to the value).</summary>
    private IReadOnlyList<ValidationIssue> StepProblems(StepForm step)
    {
        var byValue = step.Bindings.Keys.SelectMany(t => BindingProblems(step, t)).ToHashSet();
        var hinted = step.Bindings.Values.Any(b => NeedsLoop(step, b)); // "Choose what to loop over first" says it next to the value
        return Issues.Where(i => (i.Where == $"steps.{step.Alias}" || i.Where.StartsWith($"steps.{step.Alias}.")) && !byValue.Contains(i)
            && !(hinted && i.Message.StartsWith("'item' can only be used", StringComparison.Ordinal))).ToList();
    }

    /// <summary>"Current item" is chosen, but the step runs once: there is no current item yet.</summary>
    private static bool NeedsLoop(StepForm step, BindingForm binding) =>
        binding.Mode == BindingMode.FromSource && string.IsNullOrWhiteSpace(step.ForEach)
        && (binding.Expression == "item" || binding.Expression?.StartsWith("item.", StringComparison.Ordinal) == true);

    private static string SectionOf(string where) => where switch
    {
        _ when IsEndpointField(where) => "step-1",
        _ when where.StartsWith("inputs") => "step-2",
        _ when where.StartsWith("steps") => "step-3",
        _ => "step-4"
    };

    /// <summary>"Step 3, Get orders" rather than "steps.b": the words people see on the page.</summary>
    private string SectionTitle(string where)
    {
        if (where.StartsWith("steps.") && _form.Steps.FirstOrDefault(st => st.Alias == where.Split('.')[1]) is { } step) return $"Step 3, {step.DisplayName}";
        if (where.StartsWith("inputs.")) return $"Step 2, input {where["inputs.".Length..]}";
        if (where.StartsWith("combine.")) return $"Step 4, combined list {where.Split('.')[1]}";
        return SectionOf(where) switch { "step-1" => "Step 1, Endpoint", "step-2" => "Step 2, Inputs", "step-3" => "Step 3, Steps", _ => "Step 4, Response" };
    }

    private string FirstProblemAnchor => Issues.Count == 0 ? "step-5" : SectionOf(Issues[0].Where);

    private string SectionLink(string anchor) => $"{Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0]}#{anchor}";

    private IEnumerable<(int Number, string Title, string Anchor, bool Done, string State)> Steps()
    {
        string Fix(int n) => $"✕ {n} to fix";
        var p1 = ProblemsWhere(IsEndpointField).Count;
        var p2 = ProblemsWhere(w => w.StartsWith("inputs")).Count;
        var p3 = ProblemsWhere(w => w.StartsWith("steps")).Count;
        var p4 = ProblemsWhere(w => w.StartsWith("combine") || w == "response").Count;
        var hasBasics = !string.IsNullOrWhiteSpace(_form.Name) && !string.IsNullOrWhiteSpace(_form.Route);

        yield return (1, "Endpoint", "step-1", p1 == 0 && hasBasics, p1 > 0 ? Fix(p1) : hasBasics ? "" : "to do");
        yield return (2, "Inputs", "step-2", p2 == 0, p2 > 0 ? Fix(p2) : "");
        yield return (3, "Steps", "step-3", p3 == 0 && _form.Steps.Count > 0, p3 > 0 ? Fix(p3) : _form.Steps.Count == 0 ? "add a step" : "");
        yield return (4, "Response", "step-4", p4 == 0 && _form.Steps.Count > 0, p4 > 0 ? Fix(p4) : "");
        var published = _liveVersion is not null && !_hasDraft && !IsDirty;
        yield return (5, "Test and publish", "step-5", TestedCurrent || published,
            published ? $"live v{_liveVersion}" : TestedCurrent ? "passed" : _test is { Passed: false } ? "✕ didn't pass" : "not run");
    }

    /// <summary>The draft if there is one, else the live version, else (a deleted endpoint) the last version in the history.</summary>
    private async Task LoadRecipe()
    {
        await LoadRecipeCore();
        StepChoices.LoadAll(_form, LoopsFor, SourcesFor);
    }

    private async Task LoadRecipeCore()
    {
        await LoadHistory();
        // Live version and draft from the list, not the history: recipes added straight to config/recipes have no history.
        var summary = (await Admin.GetRecipesAsync(_me).ValueAsync() ?? []).FirstOrDefault(r => r.Id == Id);
        _liveVersion = summary?.PublishedVersion;
        _hasDraft = summary?.HasDraft == true;
        _deleted = summary?.Deleted == true;

        if (await Admin.GetRecipeAsync(_me, Id!).ValueAsync() is { } recipe)
        {
            _form = RecipeForm.FromRecipe(recipe);
            return;
        }

        var last = _history?.FirstOrDefault(h => h.Action != HistoryAction.Unpublished);
        if (last is not null && await Admin.GetVersionAsync(_me, Id!, last.Version).ValueAsync() is { } old) _form = RecipeForm.FromRecipe(old);
    }

    private async Task LoadHistory()
    {
        _history = (await Admin.GetHistoryAsync(_me, Id!).ValueAsync())?.ToList() ?? [];
        _viewing = null; _viewed = null; _confirmRollBack = null; _confirm = Confirm.None;
    }

    private int NextVersion => Math.Max(_liveVersion ?? 0, _history?.Select(h => h.Version).DefaultIfEmpty(0).Max() ?? 0) + 1;

    private static string Describe(HistoryRow row) => row.Action switch
    {
        HistoryAction.RolledBack => $"Rolled back: v{row.RestoredFrom} published again",
        HistoryAction.Unpublished => $"Deleted: v{row.Version} stopped being served",
        _ => "Published"
    };

    /// <summary>"Dana Tester (dev:dana-tester)" when the sign-in gave a name, else the id, else "Not recorded".</summary>
    private static string Who(HistoryRow row) =>
        row.By is null ? "Not recorded" : row.ByName is { Length: > 0 } name ? $"{name} ({row.By})" : row.By;

    private static string When(DateTimeOffset? at) =>
        at?.ToUniversalTime().ToString("d MMM yyyy, HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture) ?? "Not recorded";

    private async Task ToggleView(int version)
    {
        if (_viewing == version) { _viewing = null; _viewed = null; return; }
        _viewed = await Admin.GetVersionAsync(_me, Id!, version).ValueAsync();
        _viewing = _viewed is null ? null : version;
        if (_viewed is null) Toasts.Error($"Couldn't load version {version}. Try again.");
    }

    // ------------------------------------------------------------------ live checks (same validator as the server)

    /// <summary>
    /// The problems shown on the page. A brand-new, untouched endpoint shows none yet: nobody wants red text before typing.
    /// They appear once something changes or a save is tried. (Publishing always checks every problem.)
    /// </summary>
    private IReadOnlyList<ValidationIssue> Issues => ShowProblems ? Validation.Issues : [];

    /// <summary>Things worth a second look that don't block publishing (for example a risky combine key).</summary>
    private IReadOnlyList<ValidationIssue> Warnings => ShowProblems ? Validation.Warnings : [];

    private bool ShowProblems => !IsNew || _everSaved || _saveTried || IsDirty;

    private IReadOnlyList<SourceOption> SourcesFor(StepForm? step)
    {
        try { return new SourceCatalog().For(_form.ToRecipe(), step?.Alias, _snapshot!); }
        catch (Exception) { return []; }
    }

    private IReadOnlyList<LoopOption> LoopsFor(StepForm step)
    {
        try { return new SourceCatalog().LoopOptions(_form.ToRecipe(), step.Alias, _snapshot!); }
        catch (Exception) { return []; }
    }

    /// <summary>The gateway serves a version of this endpoint, so its step names are visible to apps (error details).</summary>
    private bool IsLive => _liveVersion is not null;

    private string RunsAfter(StepForm step)
    {
        try
        {
            var plan = ExecutionPlanner.Plan(_form.ToRecipe());
            var names = plan.DependsOn[step.Alias].Select(a => _form.Steps.FirstOrDefault(s => s.Alias == a)?.DisplayName ?? a);
            return string.Join(" and ", names);
        }
        catch (Exception) { return ""; }
    }

    // ------------------------------------------------------------------ form events

    private void OnNameChanged(string? name)
    {
        _form.Name = name ?? "";
        if (IsNew) _form.Id = Regex.Replace(_form.Name.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
    }

    private void OnRouteChanged(string? route)
    {
        _form.Route = route ?? "";
        foreach (Match m in Regex.Matches(_form.Route, @"\{([A-Za-z0-9_]+)\}"))
            if (!_form.Inputs.Any(i => i.Source == "route" && i.Name == m.Groups[1].Value))
                _form.Inputs.Add(new InputForm { Source = "route", Name = m.Groups[1].Value, Required = true });
    }

    private bool Matches(ApiService s, ApiEndpoint e) =>
        string.IsNullOrWhiteSpace(_search)
        || $"{s.Name} {e.Summary} {e.Id} {e.Method} {e.Path}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase);

    private void AddStep(ApiService service, ApiEndpoint endpoint)
    {
        var name = endpoint.Summary ?? Slug.Humanize(endpoint.Id);
        var step = new StepForm { DisplayName = name, Alias = _form.NewAlias(name) };
        _form.Steps.Add(step);
        OnEndpointChanged(step, $"{service.Id}/{endpoint.Id}");
        _picking = false;
    }

    /// <summary>Adds one response field per top-level field of the step's response (or the whole body if unknown).</summary>
    private void AddCombine()
    {
        var combine = new CombineForm { Name = _form.NewCombineName() };
        combine.Sources.Add(new CombineSourceForm());
        combine.Sources.Add(new CombineSourceForm());
        _form.Combines.Add(combine);
    }

    /// <summary>Adds the combined list to the response as a field with the same name (once).</summary>
    private void AddCombineToResponse(CombineForm combine)
    {
        var expression = $"combine.{combine.Name.Trim()}";
        if (!_form.Response.Any(f => f.Expression == expression))
            _form.Response.Add(new ResponseField { Name = combine.Name.Trim(), Expression = expression });
    }

    private void AddFieldsFrom(StepForm step)
    {
        var endpoint = _snapshot!.FindEndpoint(step.Endpoint, out _);
        var fields = endpoint?.ResponseSchema?["properties"] is JsonObject props ? props.Select(p => p.Key).ToList() : [];
        // A step that runs for each item gives one answer per call: take the field from every call (a list).
        var body = string.IsNullOrWhiteSpace(step.ForEach) ? $"{step.Alias}.body" : $"{step.Alias}[*].body";
        if (fields.Count == 0)
        {
            _form.Response.Add(new ResponseField { Name = step.Alias, Expression = body });
            return;
        }
        foreach (var f in fields.Where(f => !_form.Response.Any(r => r.Name == f)))
            _form.Response.Add(new ResponseField { Name = f, Expression = $"{body}.{f}" });
    }

    private void OnEndpointChanged(StepForm step, string? reference)
    {
        step.Endpoint = reference ?? "";
        step.Bindings.Clear();
        var endpoint = _snapshot!.FindEndpoint(step.Endpoint, out _);
        if (endpoint is null) return;

        foreach (var p in AutoBinder.PathParams(endpoint.Path))
            step.Bindings[$"path.{p}"] = new BindingForm();
        foreach (var p in endpoint.Parameters.Where(p => p.In != "path"))
            step.Bindings[$"{p.In}.{p.Name}"] = new BindingForm();

        // Pre-fill what we can; the user confirms or changes it.
        foreach (var suggestion in AutoBinder.Suggest(_form.ToRecipe(), step.Alias, _snapshot))
            step.Bindings[suggestion.Target] = new BindingForm
            {
                Mode = BindingMode.FromSource, Expression = suggestion.Expression, Suggested = true, Reason = suggestion.Reason
            };
    }

    /// <summary>
    /// A new display name. While nothing uses the step (and apps can't see it yet), its name in expressions follows along
    /// silently. Otherwise ask first: "Also rename to ordersFromCrm? 3 places use it."
    /// </summary>
    private void OnStepNameChanged(StepForm step, string? name)
    {
        name = name?.Trim();
        if (string.IsNullOrEmpty(name)) return; // an empty name would leave the step unnamed on the screen
        step.DisplayName = name;
        step.RenameProblem = null;
        step.PendingAlias = null;

        var wanted = _form.NewAlias(name, except: step);
        if (wanted == step.Alias) return;
        if (!IsLive && _form.References(step.Alias) == 0) { RenameNow(step, wanted); return; }
        step.PendingAlias = wanted;
    }

    private void RenameNow(StepForm step, string alias)
    {
        var old = step.Alias;
        step.PendingAlias = null;
        step.RenameProblem = _form.RenameStep(old, alias);
        _validation = null; // check again with the new name
    }

    private async Task CopyAlias(StepForm step)
    {
        // Only the clipboard API, no script of our own, so a Content-Security-Policy on the admin app doesn't break it.
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", step.Alias);
            Toasts.Success($"Copied {step.Alias}.");
        }
        catch (JSException) { Toasts.Error("Couldn't copy. Select the name and copy it instead."); }
    }

    /// <summary>
    /// After the loop changes: values that were only suggested (or empty) are suggested again, so "Current item" appears for a
    /// matching parameter. Values someone picked stay as they are.
    /// </summary>
    private void OnLoopChanged(StepForm step)
    {
        foreach (var binding in step.Bindings.Values.Where(b => b.Suggested && b.Expression is not null && (b.Expression == "item" || b.Expression.StartsWith("item."))))
        {
            binding.Mode = BindingMode.None; binding.Suggested = false; binding.Expression = null; binding.Reason = null;
        }

        IReadOnlyList<BindingSuggestion> suggestions;
        try { suggestions = AutoBinder.Suggest(_form.ToRecipe(), step.Alias, _snapshot!); }
        catch (Exception ex) when (ex is InvalidOperationException or FormatException) { return; }

        foreach (var s in suggestions)
            if (step.Bindings.TryGetValue(s.Target, out var current) && (current.Mode == BindingMode.None || current.Suggested))
                step.Bindings[s.Target] = new BindingForm { Mode = BindingMode.FromSource, Expression = s.Expression, Suggested = true, Reason = s.Reason };
    }

    private static string SelectValue(BindingForm b) => b.Mode switch
    {
        BindingMode.FromSource => $"src:{b.Expression}",
        BindingMode.FixedValue => "fixed",
        _ => "none"
    };

    private static void OnBindingChanged(BindingForm binding, string? value)
    {
        binding.Suggested = false;
        if (value is null || value == "none") { binding.Mode = BindingMode.None; return; }
        if (value == "fixed") { binding.Mode = BindingMode.FixedValue; return; }
        binding.Mode = BindingMode.FromSource;
        binding.Expression = value["src:".Length..];
    }

    private void AddExtraValue(StepForm step, int number)
    {
        var target = _extraTarget[number].Trim();
        if (target.Contains('.')) step.Bindings[target] = new BindingForm();
        _extraTarget[number] = "";
    }

    // ------------------------------------------------------------------ actions

    private void ShowError(string message, string? correlationId = null) { _error = message; _errorCorrelation = correlationId; }

    private async Task SaveDraftClicked()
    {
        if (await SaveDraft()) Toasts.Success("Draft saved. The live endpoint doesn't change until you publish.");
    }

    private async Task<bool> SaveDraft()
    {
        _saveTried = true;
        _busy = true;
        try
        {
            var recipe = _form.ToRecipe();
            var error = await Admin.SaveDraftAsync(_me, recipe.Id, recipe).ErrorAsync();
            if (error is not null) { ShowError(error); return false; }
            _error = null;
            _hasDraft = _everSaved = true;
            MarkSaved();
            if (IsNew) { _leaving = true; Nav.NavigateTo($"/endpoints/{_form.Id}", replace: true); _leaving = false; }
            return true;
        }
        catch (Exception ex) when (ex is InvalidOperationException or FormatException) { ShowError($"These settings can't be saved yet: {ex.Message}"); return false; }
        finally { _busy = false; }
    }

    private async Task RunTest()
    {
        if (!await SaveDraft()) return;
        _busy = _running = true;
        try
        {
            string? V(InputForm i) => string.IsNullOrWhiteSpace(i.TestValue) ? null : i.TestValue;
            var tested = CurrentJson();
            var request = new TestRequest(
                _form.Inputs.Where(i => i.Source == "route").ToDictionary(i => i.Name, V),
                _form.Inputs.Where(i => i.Source == "query").ToDictionary(i => i.Name, V),
                _form.Inputs.Where(i => i.Source == "header").ToDictionary(i => i.Name, V));
            var outcome = await Admin.TestAsync(_me, _form.Id, request, await User.CallerAsync());
            _test = outcome.Value;
            if (_test is null) { ShowError(outcome.Failure?.Message ?? "The test couldn't run.", null); return; }

            _testedJson = _test.Passed ? tested : null;
            if (_test.Passed) Toasts.Success(_caps.CanPublish ? "Test passed. You can publish now." : "Test passed. Ask a publisher to make it live.");
            else Toasts.Error("The test didn't pass. The results under step 5 show which call failed and why.", "See logs", $"/logs?correlation={Uri.EscapeDataString(_test.CorrelationId ?? "")}");
        }
        finally { _busy = _running = false; }
    }

    /// <summary>Swagger UI deep link to this endpoint: #/&lt;tag&gt;/&lt;operationId&gt;, the tag being the first part of the route.</summary>
    private string DocsLink
    {
        get
        {
            var gateway = (Config["Gateway:BaseUrl"] ?? "http://localhost:5200/").TrimEnd('/');
            var tag = _form.Route.Trim('/').Split('/')[0];
            if (tag.StartsWith('{')) tag = "other";
            return $"{gateway}/bff/docs#/{Uri.EscapeDataString(tag)}/{Uri.EscapeDataString(_form.Id)}";
        }
    }

    private async Task Publish()
    {
        _busy = true;
        try
        {
            var error = await Admin.PublishAsync(_me, _form.Id).ErrorAsync();
            if (error is not null) { ShowError(error); return; }
            _error = null;
            await LoadRecipe();
            MarkSaved();
            Toasts.Success($"Published. Callers can use {_form.Method} /bff/{_form.Route.Trim('/')} now.", "Try it in API docs", DocsLink);
        }
        finally { _busy = false; }
    }

    private async Task RollBack(int version)
    {
        var newVersion = NextVersion;
        var error = await Admin.RollBackAsync(_me, _form.Id, version).ErrorAsync();
        if (error is not null) { _confirmRollBack = null; ShowError(error); return; }
        await LoadRecipe();
        MarkSaved();
        Toasts.Success($"Version {version} is live again, as v{newVersion}." +
            (_hasDraft ? " Your unpublished changes are still here: publishing them would replace it." : ""));
    }

    private async Task DiscardDraft()
    {
        var error = await Admin.DiscardDraftAsync(_me, _form.Id).ErrorAsync();
        if (error is not null) { _confirm = Confirm.None; ShowError(error); return; }

        _test = null; _testedJson = null;
        await LoadRecipe();
        MarkSaved();
        if (_liveVersion is null && !_deleted) { _leaving = true; Toasts.Success("Draft discarded."); Nav.NavigateTo("/endpoints"); return; } // nothing left to show
        Toasts.Success(_liveVersion is { } live ? $"Changes discarded. Showing the live version, v{live}." : "Changes discarded. Showing the last published version.");
    }

    private async Task DeleteEndpoint()
    {
        var address = $"{_form.Method} /bff/{_form.Route.Trim('/')}";
        var error = await Admin.DeleteEndpointAsync(_me, _form.Id).ErrorAsync();
        if (error is not null) { _confirm = Confirm.None; ShowError(error); return; }

        _test = null; _testedJson = null;
        await LoadRecipe();
        MarkSaved();
        if (_history is not { Count: > 0 }) { _leaving = true; Toasts.Success("Deleted. It was never published, so nothing else changes."); Nav.NavigateTo("/endpoints"); return; }
        Toasts.Success($"Deleted. The gateway stops serving {address} within a few seconds. To restore it, roll back to a version under History.");
    }
}
