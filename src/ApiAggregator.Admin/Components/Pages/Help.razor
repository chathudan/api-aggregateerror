@page "/help"
@page "/help/{Topic}"

@* Help: a short home page (what do you want to do?) and one short page per topic (Components/Help). The full guides in
   docs/guides keep the long form and the checked examples; every page links to its guide. *@

<PageTitle>@(_topic?.Title ?? "Help") · Help · API Aggregator</PageTitle>

<div class="help">
<nav class="toc" aria-label="Help pages">
    <a href="/help"><strong>Help</strong></a>
    <span class="muted">What do you want to do?</span>
    @foreach (var t in HelpTopics.All.Where(t => t.IsTask)) { <a href="/help/@t.Id" aria-current="@(t == _topic ? "page" : null)">@t.Title</a> }
    <span class="muted">More</span>
    @foreach (var t in HelpTopics.All.Where(t => !t.IsTask)) { <a href="/help/@t.Id" aria-current="@(t == _topic ? "page" : null)">@t.Title</a> }
</nav>

<article>
    @if (_topic is not null)
    {
        <h1>@_topic.Title</h1>
        <p class="lead">@_topic.Summary <GuideLink Guide="@_topic.Guide" /></p>
        <DynamicComponent Type="_topic.Component" />
    }
    else
    {
        <h1>Help</h1>
        @if (!string.IsNullOrEmpty(Topic))
        {
            <p class="issues warnings">There's no help page called <code>@Topic</code>. Pick one below.</p>
        }
        <p class="lead">Connect services and combine their endpoints into one endpoint for web and mobile apps. No coding needed.</p>

        <div class="help-tasks">
            @foreach (var t in HelpTopics.All.Where(t => t.IsTask))
            {
                <a class="help-task" href="/help/@t.Id"><strong>@t.Title</strong><span>@t.Summary</span></a>
            }
        </div>

        <h2>Learn by doing</h2>
        <p>The guide builds a whole endpoint with you, using the sample data: contacts, their orders, and the notes of each contact with an order. Each step ticks itself off as you do it.</p>
        <p><a class="button primary" href="/endpoints/new?guide=first">Build your first endpoint with the guide</a></p>

        <h2>More help</h2>
        <ul class="help-more">
            @foreach (var t in HelpTopics.All.Where(t => !t.IsTask)) { <li><a href="/help/@t.Id">@t.Title</a>: @t.Summary</li> }
        </ul>
        <p class="hint">Every example uses the sample data (the mock services and <code>samples/config</code>), so you can try it as you read. Each page links to its <strong>full guide</strong>, which shows every answer in full.</p>
    }
</article>
</div>

@code {
    [Parameter] public string? Topic { get; set; }

    private HelpTopic? _topic;

    protected override void OnParametersSet() => _topic = HelpTopics.Find(Topic);
}
