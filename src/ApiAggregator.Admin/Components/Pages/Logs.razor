@page "/logs"
@using ApiAggregator.Engine.Logging.Live
@implements IAsyncDisposable
@inject LiveLogClient LogClient

<PageShell Title="Logs" HelpTopic="logs"
           Purpose="The latest 2,000 lines from the gateway and this admin app. Logs never include customer data or secrets. With several gateway instances in production, use your central log store." />

<section class="card">
    <div class="log-controls">
        <label>Source
            <select @bind="SourceFilter">
                <option value="">All</option>
                <option value="Gateway">Gateway</option>
                <option value="Admin">Admin</option>
            </select>
        </label>
        <label>Level
            <select @bind="LevelFilter">
                <option value="">All</option>
                <option value="warn">Warnings and errors</option>
                <option value="error">Errors only</option>
            </select>
        </label>
        <label class="log-search">Search
            <input type="text" placeholder="Message, step, service, endpoint, error code or correlation id" @bind="Search" @bind:event="oninput" />
        </label>
        <button class="button" @onclick="TogglePause">@(_paused ? "Resume" : "Pause")</button>
        <button class="button" @onclick="Clear">Clear</button>
    </div>

    <div class="inline">
        @if (_paused)
        {
            <span class="tag warn">Paused: @_newWhilePaused new</span>
        }
        @if (!string.IsNullOrEmpty(_correlation))
        {
            <span class="tag chip">Correlation: @_correlation <button class="chip-x" title="Show all requests again" @onclick="ClearCorrelation">×</button></span>
        }
        <span class="@StatusClass(_gateway)">Gateway: @_gateway.Text</span>
        <span class="@StatusClass(_admin)">Admin: @_admin.Text</span>
    </div>

    @if (_rows.Count == 0)
    {
        <p class="muted">No log lines yet. Call an aggregated endpoint or use Try it, and they'll appear here.</p>
    }
    else
    {
        <table class="list log-table">
            <thead><tr><th>Time</th><th>Source</th><th>Level</th><th>Event</th><th>Message</th><th>Correlation</th></tr></thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    var e = row.Entry;
                    var key = row.Key;
                    <tr class="log-row" @onclick="() => ToggleDetails(key)" @key="key">
                        <td class="nowrap">@e.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</td>
                        <td>@row.Source</td>
                        <td><span class="tag @LevelClass(e.Level)">@e.Level</span></td>
                        <td>@(e.EventName ?? e.EventId.ToString())</td>
                        <td class="log-message">
                            @e.Message
                            @if (!string.IsNullOrEmpty(e.ErrorCode)) { <span class="tag error">@e.ErrorCode</span> }
                            @if (e.Exception is not null && e.Page is not null) { <span class="muted"> on @e.Page</span> }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(e.CorrelationId))
                            {
                                <button class="link" title="@e.CorrelationId" @onclick="() => SetCorrelation(e.CorrelationId!)" @onclick:stopPropagation="true">@Short(e.CorrelationId)</button>
                            }
                        </td>
                    </tr>
                    @if (_expanded.Contains(key))
                    {
                        <tr class="log-details">
                            <td colspan="6">
                                <dl>
                                    <dt>Logger</dt><dd>@e.Category</dd>
                                    @if (e.RecipeId is not null) { <dt>Endpoint (recipe)</dt><dd>@e.RecipeId</dd> }
                                    @if (e.Step is not null) { <dt>Step</dt><dd>@e.Step</dd> }
                                    @if (e.ServiceId is not null) { <dt>Service</dt><dd>@e.ServiceId</dd> }
                                    @if (e.ErrorCode is not null) { <dt>Error code</dt><dd>@e.ErrorCode</dd> }
                                    @if (e.CorrelationId is not null) { <dt>Correlation id</dt><dd>@e.CorrelationId</dd> }
                                    @if (e.Page is not null) { <dt>Page</dt><dd>@e.Page</dd> }
                                    @if (e.Exception is not null) { <dt>Exception</dt><dd>@e.Exception</dd> }
                                    @if (e.Location is not null) { <dt>Code location</dt><dd><code>@e.Location</code></dd> }
                                </dl>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</section>

@code {
    private const int MaxRowsInPage = 1000;

    /// <summary>Pre-sets the correlation filter, e.g. from the "See logs for this test" link.</summary>
    [SupplyParameterFromQuery(Name = "correlation")] public string? CorrelationFromQuery { get; set; }

    /// <summary>Pre-sets the level filter: "warn" (warnings and errors) or "error", e.g. from the Home page.</summary>
    [SupplyParameterFromQuery(Name = "level")] public string? LevelFromQuery { get; set; }

    private sealed record Row(string Source, LiveLogEntry Entry)
    {
        public string Key => $"{Source}:{Entry.Seq}";
    }

    private sealed record SourceStatus(bool Ok, string Text);

    private readonly List<Row> _all = [];              // everything collected, oldest first
    private List<Row> _visibleSnapshot = [];           // what the table is built from while paused
    private List<Row> _rows = [];                      // what the table shows right now (filtered, newest first)
    private readonly HashSet<string> _expanded = [];

    private string _sourceFilter = "";
    private string _levelFilter = "";
    private string _search = "";

    // Filter inputs rebuild the table rows when they change.
    private string SourceFilter { get => _sourceFilter; set { _sourceFilter = value; Refilter(); } }
    private string LevelFilter { get => _levelFilter; set { _levelFilter = value; Refilter(); } }
    private string Search { get => _search; set { _search = value; Refilter(); } }
    private string? _correlation;
    private bool _paused;
    private int _newWhilePaused;
    private SourceStatus _gateway = new(false, "connecting…");
    private SourceStatus _admin = new(false, "connecting…");

    private CancellationTokenSource? _cts;
    private Task[] _loops = [];

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(CorrelationFromQuery)) _correlation = CorrelationFromQuery;
        if (LevelFromQuery is "warn" or "error") _levelFilter = LevelFromQuery;
        Refilter();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // Start polling once the page is interactive (not while it is pre-rendered).
        if (firstRender)
        {
            _cts = new CancellationTokenSource();
            _loops = [PollAsync(LogSource.Gateway, _cts.Token), PollAsync(LogSource.Admin, _cts.Token)];
        }
        return Task.CompletedTask;
    }

    /// <summary>Reads one process forever: long-poll for new lines, merge them in, retry every 5 seconds on errors.</summary>
    private async Task PollAsync(LogSource source, CancellationToken ct)
    {
        long after = 0;
        var first = true;
        while (!ct.IsCancellationRequested)
        {
            try
            {
                // The first read doesn't wait, so lines already in memory show up straight away.
                var (page, error) = await LogClient.ReadAsync(source, after, first ? 0 : 10, ct);
                if (page is null)
                {
                    await SetStatus(source, false, $"{error}");
                    await Task.Delay(TimeSpan.FromSeconds(5), ct);
                    continue;
                }

                first = false;
                // A lower "latest" than our cursor means that process restarted: start again from its first line.
                if (page.Latest < after) after = 0;
                else if (page.Entries.Count > 0) after = page.Entries[^1].Seq;
                await Merge(source, page);
            }
            catch (OperationCanceledException) { return; } // the user left the page
            catch (Exception)
            {
                await SetStatus(source, false, "had a problem reading logs. Trying again…");
                try { await Task.Delay(TimeSpan.FromSeconds(5), ct); } catch (OperationCanceledException) { return; }
            }
        }
    }

    private Task SetStatus(LogSource source, bool ok, string text) => InvokeAsync(() =>
    {
        var status = new SourceStatus(ok, ok ? "connected" : text);
        if (source == LogSource.Gateway) _gateway = status; else _admin = status;
        StateHasChanged();
    });

    private Task Merge(LogSource source, LogPage page) => InvokeAsync(() =>
    {
        if (source == LogSource.Gateway) _gateway = new SourceStatus(true, "connected");
        else _admin = new SourceStatus(true, "connected");

        if (page.Entries.Count > 0)
        {
            var label = source == LogSource.Gateway ? "Gateway" : "Admin";
            _all.AddRange(page.Entries.Select(e => new Row(label, e)));
            var ordered = _all.OrderBy(r => r.Entry.Timestamp).ThenBy(r => r.Entry.Seq).TakeLast(MaxRowsInPage).ToList();
            _all.Clear();
            _all.AddRange(ordered);
            if (_paused) _newWhilePaused += page.Entries.Count;
        }
        Refilter();
        StateHasChanged();
    });

    // ------------------------------------------------------------------ filters and buttons

    /// <summary>Builds the table rows: newest first, filtered. While paused it keeps showing the lines from when Pause was pressed.</summary>
    private void Refilter()
    {
        var source = _paused ? _visibleSnapshot : _all;
        _rows = source.Where(Matches).Reverse().ToList();
    }

    private bool Matches(Row row)
    {
        var e = row.Entry;
        if (_sourceFilter != "" && row.Source != _sourceFilter) return false;
        if (_levelFilter == "warn" && e.Level is not ("Warning" or "Error" or "Critical")) return false;
        if (_levelFilter == "error" && e.Level is not ("Error" or "Critical")) return false;
        if (!string.IsNullOrEmpty(_correlation) && e.CorrelationId != _correlation) return false;

        if (string.IsNullOrWhiteSpace(_search)) return true;
        var text = _search.Trim();
        return new[] { e.Message, e.Step, e.ServiceId, e.RecipeId, e.ErrorCode, e.CorrelationId }
            .Any(field => field?.Contains(text, StringComparison.OrdinalIgnoreCase) == true);
    }

    private void TogglePause()
    {
        _paused = !_paused;
        _newWhilePaused = 0;
        _visibleSnapshot = [.. _all];
        Refilter();
    }

    private void Clear()
    {
        // Only this page's list: the processes keep their own memory, and the cursors stay so cleared lines don't return.
        _all.Clear();
        _visibleSnapshot = [];
        _expanded.Clear();
        _newWhilePaused = 0;
        Refilter();
    }

    private void SetCorrelation(string id) { _correlation = id; Refilter(); }
    private void ClearCorrelation() { _correlation = null; Refilter(); }

    private static string StatusClass(SourceStatus s) => s.Ok ? "ok-inline" : s.Text.StartsWith("connecting") ? "status" : "bad-inline";

    private void ToggleDetails(string key)
    {
        if (!_expanded.Remove(key)) _expanded.Add(key);
    }

    private static string Short(string id) => id.Length <= 8 ? id : id[..8];

    private static string LevelClass(string level) => level switch
    {
        "Warning" => "warn",
        "Error" or "Critical" => "error",
        _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        // Stop the polling loops when the user leaves the page.
        if (_cts is null) return;
        _cts.Cancel();
        try { await Task.WhenAll(_loops); } catch (Exception) { /* cancelled: nothing to report */ }
        _cts.Dispose();
    }
}
