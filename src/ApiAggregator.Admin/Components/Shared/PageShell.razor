@* The same frame on every page: breadcrumb (detail pages), title, one short purpose line, actions on the right.
   Put at most ONE "button primary" in Actions: the main thing to do on this page. *@
<PageTitle>@Title · API Aggregator</PageTitle>

<div class="page-head">
    @if (Crumbs is { Count: > 0 })
    {
        <nav class="crumbs" aria-label="You are here">
            @foreach (var (text, href) in Crumbs)
            {
                <a href="@href">@text</a><span aria-hidden="true"> › </span>
            }
            <span aria-current="page">@Title</span>
        </nav>
    }
    <div class="header-row">
        <div>
            <h1 id="page-title">@Title</h1>
            @if (!string.IsNullOrEmpty(Purpose)) { <p class="purpose">@Purpose @if (HelpTopic is not null) { <HelpLink Topic="@HelpTopic" /> }</p> }
        </div>
        @if (Actions is not null) { <div class="actions">@Actions</div> }
    </div>
</div>
@ChildContent

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Purpose { get; set; }
    [Parameter] public string? HelpTopic { get; set; }
    /// <summary>Parent pages, e.g. ("Endpoints", "/endpoints").</summary>
    [Parameter] public IReadOnlyList<(string Text, string Href)>? Crumbs { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
