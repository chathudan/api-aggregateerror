@* What to show when a list has nothing in it yet: what it is for, and the one thing to do next. *@
<div class="card empty">
    <h2>@Title</h2>
    @ChildContent
    @if (Action is not null) { <div class="inline center">@Action</div> }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Action { get; set; }
}
