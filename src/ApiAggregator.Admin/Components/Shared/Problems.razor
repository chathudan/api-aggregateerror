@if (Items is { Count: > 0 })
{
    <div class="issues">
        <strong>@Title</strong>
        <ul>@foreach (var item in Items) { <li>@item</li> }</ul>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<string>? Items { get; set; }
    [Parameter] public string Title { get; set; } = "Before you save";
}
