{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ApiAggregator": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "None"
    }
  },
  "AllowedHosts": "*",
  "LiveLogs": {
    "Enabled": true,
    "Capacity": 2000
  },
  "Aggregator": {
    "Config": {
      "Directory": "../../config",
      "ReloadCheckSeconds": 1
    }
  },
  "Auth": {
    "Authority": "",
    "Audience": "api-aggregator"
  },
  "Admin": {
    "RequireTestBeforePublish": true,
    "AllowedOrigins": [
      "http://localhost:5300"
    ],
    "OpenApiAllowedHosts": []
  }
}
