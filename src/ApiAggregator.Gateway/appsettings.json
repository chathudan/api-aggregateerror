{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ApiAggregator": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "None"
    }
  },
  "AllowedHosts": "*",
  "LiveLogs": {
    "Enabled": true,
    "Capacity": 2000
  },
  "Aggregator": {
    "Config": {
      "Directory": "../../config",
      "ReloadCheckSeconds": 2
    },
    "Engine": {
      "MaxResponseBytes": 5242880,
      "MaxForEachItems": 100,
      "CacheSizeMb": 256
    }
  },
  "Gateway": {
    "RequestsPerMinutePerCaller": 600,
    "Cors": {
      "AllowedOrigins": [],
      "AllowedOriginPatterns": [],
      "PreflightMaxAgeSeconds": 600
    },
    "OpenApi": {
      "Enabled": true,
      "IncludeInternalDetails": false
    }
  },
  "Auth": {
    "Authority": "",
    "Audience": "api-aggregator"
  }
}
