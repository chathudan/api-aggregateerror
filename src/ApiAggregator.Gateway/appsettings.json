{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Aggregator": {
    "Config": { "Directory": "../../config", "ReloadCheckSeconds": 2 },
    "Engine": { "MaxResponseBytes": 5242880, "MaxForEachItems": 100, "CacheSizeMb": 256 }
  },
  "Gateway": { "RequestsPerMinutePerCaller": 600 },
  "Auth": {
    "Authority": "",
    "Audience": "api-aggregator"
  }
}
