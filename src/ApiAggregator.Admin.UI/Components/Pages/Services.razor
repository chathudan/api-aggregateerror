@page "/services"
@inject AdminApiClient Api

<PageShell Title="Services" Purpose="The APIs you can combine into aggregated endpoints, and how the gateway signs in to each." HelpTopic="add-service">
    <Actions>
        @if (_newService is null) { <button class="button primary" @onclick="StartNewService">Add service</button> }
    </Actions>
</PageShell>

@* ------------------------------------------------------------------ add service *@
@if (_newService is { } ns)
{
    <section class="card accent">
        <div class="header-row"><h2>Add a service</h2><HelpLink Topic="before" Text="What to ask the service owner" /></div>

        <div class="choice">
            <button class="kind @(ns.FromSpec ? "selected" : "")" @onclick="() => ns.FromSpec = true">
                <strong>From an OpenAPI spec</strong><span>Recommended. Endpoints, parameters and fields are filled in for you.</span>
            </button>
            <button class="kind @(!ns.FromSpec ? "selected" : "")" @onclick="() => ns.FromSpec = false">
                <strong>Enter by hand</strong><span>For services without a spec. Add endpoints afterwards.</span>
            </button>
        </div>

        @if (ns.FromSpec)
        {
            <div class="inline">
                <label class="grow">Spec address <input @bind="ns.SpecUrl" placeholder="https://orders.internal/swagger/v1/swagger.json" /></label>
                <button class="button" @onclick="LoadSpec">Load</button>
            </div>
        }

        <div class="grid">
            <label>Name <input @bind="ns.Name" placeholder="Orders service" /></label>
            <label>Base address <input @bind="ns.BaseUrl" placeholder="https://orders.internal/api" /></label>
        </div>
        @if (!string.IsNullOrEmpty(ns.Name)) { <p class="hint">Id: <code>@ns.Id</code></p> }

        @if (ns.FromSpec && ns.Operations.Count > 0)
        {
            <h3>Operations to import <span class="muted">(@ns.Selected.Count of @ns.Operations.Count)</span></h3>
            <div class="ops">
                @foreach (var op in ns.Operations)
                {
                    var id = op["operationId"]!.ToString();
                    <label class="check">
                        <input type="checkbox" checked="@ns.Selected.Contains(id)" @onchange="e => Toggle(ns.Selected, id, (bool)e.Value!)" />
                        <code>@op["method"] @op["path"]</code> <span class="muted">@(op["summary"]?.ToString() ?? id)</span>
                    </label>
                }
            </div>
        }

        <h3>How the gateway signs in <HelpLink Topic="sign-in" Text="Which one do I pick?" /></h3>
        @if (ns.SuggestedSignIn is not null) { <p class="hint">The spec suggests <strong>@SignInKinds.Get(ns.SuggestedSignIn).Title</strong>. Change it if needed.</p> }
        <SignInEditor Form="ns.SignIn" ServiceId="@ns.Id" CanSaveSecrets="_canSaveSecrets" />

        <Problems Items="_problems" />
        <div class="inline">
            <button class="button primary" @onclick="SaveNewService">Save service</button>
            <button class="link" @onclick="() => _newService = null">Cancel</button>
        </div>
    </section>
}

@* ------------------------------------------------------------------ existing services *@
@if (_services is null)
{
    <p class="muted">Loading…</p>
}
else if (_services.Count == 0 && _newService is null)
{
    <div class="card empty">
        <h2>Add your first service</h2>
        <p>Point at an OpenAPI spec or enter the address by hand.</p>
        <button class="button" @onclick="StartNewService">Add service</button>
    </div>
}
else
{
    @foreach (var s in _services)
    {
        var profile = _profiles.FirstOrDefault(p => p.Id == s.AuthProfileId);
        <section class="card" id="service-@s.Id">
            <div class="header-row">
                <div>
                    <h2>@(string.IsNullOrEmpty(s.Name) ? s.Id : s.Name)</h2>
                    <p class="muted">
                        <code>@s.BaseUrl</code> ·
                        @(profile is null ? "No sign-in" : string.Join(" + ", profile.Steps.Select(st => SignInKinds.Get(st.Kind).Title)))
                    </p>
                </div>
                <div class="inline">
                    <button class="button" @onclick="() => Open(s.Id, Panel.Endpoint)">Add endpoint</button>
                    <button class="button" @onclick="() => OpenSignIn(s, profile)">Sign-in</button>
                    <button class="button" @onclick="() => Open(s.Id, Panel.Import)">Import from OpenAPI</button>
                    <button class="link" @onclick="() => OpenRename(s)">Rename</button>
                    <button class="link" @onclick="() => OpenDelete(s)">Delete</button>
                </div>
            </div>

            @if (_checks.TryGetValue(s.Id, out var check)) { <p class="@(check.Ok ? "ok" : "bad")">@check.Message @if (!check.Ok) { <HelpLink Topic="troubleshooting" Text="What does this mean?" /> }</p> }

            @if (s.Endpoints.Count == 0)
            {
                <p class="muted">No endpoints yet. Use <strong>Add endpoint</strong> or <strong>Import from OpenAPI</strong>.</p>
            }
            else
            {
                <table class="list">
                    <thead><tr><th>Endpoint</th><th>Call</th><th>Parameters</th><th>Fields known</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var e in s.Endpoints)
                        {
                            <tr>
                                <td>@(e.Summary ?? Slug.Humanize(e.Id))</td>
                                <td><code>@e.Method @e.Path</code></td>
                                <td>@string.Join(", ", e.Parameters.Select(p => $"{p.Name} ({p.In}{(p.Required ? ", required" : "")})"))</td>
                                <td>@(e.ResponseSchema is null ? "—" : "Yes")</td>
                                <td><button class="link" @onclick="() => RemoveEndpoint(s, e)">Remove</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @* --- add endpoint by hand *@
            @if (_openFor == s.Id && _panel == Panel.Endpoint)
            {
                <div class="panel">
                    <h3>Add an endpoint <HelpLink Topic="add-endpoint" /></h3>
                    <div class="grid">
                        <label>Name <input @bind="_newEndpoint.Name" placeholder="Get order lines" /></label>
                        <label>Method
                            <select @bind="_newEndpoint.Method">
                                @foreach (var m in new[] { "GET", "POST", "PUT", "PATCH", "DELETE" }) { <option>@m</option> }
                            </select>
                        </label>
                        <label class="grow">Path <input @bind="_newEndpoint.Path" @bind:event="oninput" placeholder="/orders/{orderId}/lines" /></label>
                    </div>
                    @if (_newEndpoint.PathParams.Any())
                    {
                        <p class="hint">Path values: @string.Join(", ", _newEndpoint.PathParams) (required)</p>
                    }
                    <table class="list">
                        <thead><tr><th>Other value</th><th>Sent as</th><th>Required</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in _newEndpoint.Parameters)
                            {
                                <tr>
                                    <td><input @bind="p.Name" placeholder="status or X-Customer-Id" /></td>
                                    <td><select @bind="p.In"><option>query</option><option>header</option><option>cookie</option></select></td>
                                    <td><input type="checkbox" @bind="p.Required" /></td>
                                    <td><button class="link" @onclick="() => _newEndpoint.Parameters.Remove(p)">Remove</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button class="link" @onclick="() => _newEndpoint.Parameters.Add(new ParamRow())">Add a query or header value</button>
                    <label>Sample response (optional, lets the wizard offer its fields)
                        <textarea rows="5" @bind="_newEndpoint.SampleResponse" placeholder='{ "id": "O-1", "total": 20.5, "items": [ { "sku": "A" } ] }'></textarea>
                    </label>
                    <Problems Items="_problems" />
                    <div class="inline">
                        <button class="button primary" @onclick="() => SaveEndpoint(s)">Add endpoint</button>
                        <button class="link" @onclick="Close">Cancel</button>
                    </div>
                </div>
            }

            @* --- sign-in *@
            @if (_openFor == s.Id && _panel == Panel.SignIn && _signIn is not null)
            {
                <div class="panel">
                    <h3>How the gateway signs in to @s.Name <HelpLink Topic="sign-in" Text="Which one do I pick?" /></h3>
                    <SignInEditor Form="_signIn" ServiceId="@s.Id" CanSaveSecrets="_canSaveSecrets" />
                    <Problems Items="_problems" />
                    <div class="inline">
                        <button class="button primary" @onclick="() => SaveSignIn(s, profile)">Save sign-in</button>
                        @if (profile is not null) { <button class="button" @onclick="() => Check(s, profile)">Check sign-in</button> }
                        <button class="link" @onclick="Close">Cancel</button>
                    </div>
                </div>
            }

            @* --- rename *@
            @if (_openFor == s.Id && _panel == Panel.Rename)
            {
                <div class="panel">
                    <h3>Rename @s.Name <HelpLink Topic="delete" /></h3>
                    <div class="inline">
                        <label class="grow">Display name <input @bind="_newName" maxlength="100" /></label>
                        <button class="button primary" @onclick="() => Rename(s)">Save name</button>
                        <button class="link" @onclick="Close">Cancel</button>
                    </div>
                    <p class="hint">Only the name people see changes. The id <code>@s.Id</code> stays the same, so endpoints that use this service keep working.</p>
                    <Problems Items="_problems" />
                </div>
            }

            @* --- delete *@
            @if (_openFor == s.Id && _panel == Panel.Delete && _usage is { } usage)
            {
                <div class="panel">
                    @if (usage.Published.Count > 0)
                    {
                        <div class="issues">
                            <strong>@s.Name can't be deleted yet.</strong> These published endpoints still call it. Change them to use another service, or delete them, first:
                            <ul>@foreach (var r in usage.Published) { <li><a href="/endpoints/@r.Id">@r.Name</a></li> }</ul>
                        </div>
                        <button class="link" @onclick="Close">Close</button>
                    }
                    else
                    {
                        <ConfirmBox Danger="true" ConfirmText="@($"Delete {s.Name}")" OnConfirm="() => DeleteService(s)" OnCancel="Close">
                            <p>@s.Name and its @s.Endpoints.Count endpoint(s) are removed from this list. No published endpoint uses it.</p>
                            @if (usage.Drafts.Count > 0)
                            {
                                <p>These <strong>drafts</strong> use it and will show a problem until you change them:</p>
                                <ul>@foreach (var r in usage.Drafts) { <li><a href="/endpoints/@r.Id">@r.Name</a></li> }</ul>
                            }
                            @if (profile is not null) { <p class="hint">Its sign-in settings are kept, because another service may use them.</p> }
                        </ConfirmBox>
                    }
                </div>
            }

            @* --- import *@
            @if (_openFor == s.Id && _panel == Panel.Import)
            {
                <div class="panel">
                    <h3>Import endpoints from a spec</h3>
                    <div class="inline">
                        <label class="grow">Spec address <input @bind="_specUrl" placeholder="https://service/openapi.json" /></label>
                        <button class="button" @onclick="() => Preview(s)">Load operations</button>
                    </div>
                    @if (_candidates is not null)
                    {
                        <p class="hint">Existing endpoints with the same id are updated, not duplicated.</p>
                        <div class="ops">
                            @foreach (var c in _candidates)
                            {
                                var id = c["operationId"]!.ToString();
                                <label class="check">
                                    <input type="checkbox" checked="@_selected.Contains(id)" @onchange="e => Toggle(_selected, id, (bool)e.Value!)" />
                                    <code>@c["method"] @c["path"]</code> <span class="muted">@(c["summary"]?.ToString() ?? id)</span>
                                </label>
                            }
                        </div>
                        <button class="button primary" @onclick="() => Import(s)">Import @_selected.Count operation(s)</button>
                    }
                    <button class="link" @onclick="Close">Cancel</button>
                </div>
            }
        </section>
    }
}

@if (_message is not null) { <p class="status">@_message</p> }

@code {
    private enum Panel { None, Endpoint, SignIn, Import, Rename, Delete }

    private List<ApiService>? _services;
    private List<AuthProfile> _profiles = [];
    private bool _canSaveSecrets;
    private NewServiceForm? _newService;
    private NewEndpointForm _newEndpoint = new();
    private SignInForm? _signIn;
    private string? _openFor;
    private Panel _panel;
    private string _specUrl = "";
    private List<JsonNode>? _candidates;
    private readonly HashSet<string> _selected = [];
    private readonly Dictionary<string, (bool Ok, string Message)> _checks = [];
    private List<string> _problems = [];
    private string? _message;
    private string _newName = "";
    private ServiceUsage? _usage;

    /// <summary>"/services?add=1" opens Add service straight away (the Home page's quick action).</summary>
    [SupplyParameterFromQuery(Name = "add")] public int? AddFromQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _canSaveSecrets = await Api.CanSaveSecretsAsync();
        await Reload();
        if (AddFromQuery == 1) StartNewService();
    }

    private async Task Reload()
    {
        _services = await Api.GetServicesAsync() ?? [];
        _profiles = await Api.GetAuthProfilesAsync() ?? [];
    }

    private void Open(string serviceId, Panel panel)
    {
        _openFor = serviceId; _panel = panel; _problems = []; _message = null;
        _newEndpoint = new NewEndpointForm();
        _candidates = null; _selected.Clear();
        _specUrl = _services?.FirstOrDefault(s => s.Id == serviceId)?.OpenApiSource ?? "";
    }

    private void Close() { _openFor = null; _panel = Panel.None; _problems = []; }

    private static void Toggle(HashSet<string> set, string id, bool on) { if (on) set.Add(id); else set.Remove(id); }

    // ------------------------------------------------------------------ add service

    private void StartNewService() { _newService = new NewServiceForm(); _problems = []; _message = null; }

    private async Task LoadSpec()
    {
        var ns = _newService!;
        var preview = await Api.PreviewOpenApiAsync("new", ns.SpecUrl);
        if (preview?["endpoints"] is null) { _problems = [preview?["title"]?.ToString() ?? "Couldn't read that spec. Check the address."]; return; }
        ns.ApplyPreview(preview);
        _problems = [];
    }

    private async Task SaveNewService()
    {
        var ns = _newService!;
        _problems = ns.Problems().ToList();
        if (_services!.Any(s => s.Id == ns.Id)) _problems.Add($"A service with id '{ns.Id}' already exists. Pick another name.");
        if (_problems.Count > 0) return;

        var profile = ns.SignIn.ToProfile($"{ns.Id}-signin", ns.Id, ns.Name, out var secrets);
        if (await SaveSignInParts(profile, secrets) is { } error) { _problems = [error]; return; }

        var service = new ApiService { Id = ns.Id, Name = ns.Name.Trim(), BaseUrl = ns.BaseUrl.Trim(), AuthProfileId = profile?.Id, TimeoutMs = ns.TimeoutMs, OpenApiSource = ns.FromSpec ? ns.SpecUrl : null };
        if (await Api.SaveServiceAsync(service) is { } saveError) { _problems = [saveError]; return; }
        if (ns.FromSpec && await Api.ImportOpenApiAsync(service.Id, ns.SpecUrl, ns.Selected.ToArray()) is { } importError) { _problems = [importError]; return; }

        _message = $"{service.Name} added{(ns.FromSpec ? $" with {ns.Selected.Count} endpoint(s)" : ". Add its endpoints next")}.";
        _newService = null;
        await Reload();
        if (profile is not null) await Check(service, profile);
    }

    // ------------------------------------------------------------------ endpoints, sign-in, import

    private async Task SaveEndpoint(ApiService s)
    {
        _problems = _newEndpoint.Problems(s).ToList();
        if (_problems.Count > 0) return;
        var endpoint = _newEndpoint.ToEndpoint();
        if (await Api.SaveServiceAsync(s.With(s.Endpoints.Append(endpoint).ToList())) is { } error) { _problems = [error]; return; }
        _message = $"Added {endpoint.Summary} to {s.Name}.";
        Close();
        await Reload();
    }

    private async Task RemoveEndpoint(ApiService s, ApiEndpoint e)
    {
        var error = await Api.SaveServiceAsync(s.With(s.Endpoints.Where(x => x.Id != e.Id).ToList()));
        _message = error ?? $"Removed {e.Summary ?? e.Id}. Endpoints that used it will show a problem until you change them.";
        await Reload();
    }

    private void OpenSignIn(ApiService s, AuthProfile? profile)
    {
        Open(s.Id, Panel.SignIn);
        _signIn = SignInForm.From(profile);
    }

    private async Task SaveSignIn(ApiService s, AuthProfile? existing)
    {
        _problems = _signIn!.Problems().ToList();
        if (_problems.Count > 0) return;

        var profile = _signIn.ToProfile(existing?.Id ?? $"{s.Id}-signin", s.Id, s.Name, out var secrets);
        if (await SaveSignInParts(profile, secrets) is { } error) { _problems = [error]; return; }
        if (await Api.SaveServiceAsync(s.With(authProfileId: profile?.Id, clearAuth: profile is null)) is { } saveError) { _problems = [saveError]; return; }

        Close();
        await Reload();
        if (profile is not null) await Check(s, profile); else _message = $"{s.Name} now has no sign-in.";
    }

    /// <summary>Secrets first (Development only), then the profile, so the profile never points at a missing secret.</summary>
    private async Task<string?> SaveSignInParts(AuthProfile? profile, Dictionary<string, string> secrets)
    {
        if (profile is null) return null;
        if (_canSaveSecrets)
            foreach (var (name, value) in secrets)
                if (await Api.SaveSecretAsync(name, value) is { } error) return error;
        return await Api.SaveAuthProfileAsync(profile);
    }

    // ------------------------------------------------------------------ rename, delete

    private void OpenRename(ApiService s)
    {
        Open(s.Id, Panel.Rename);
        _newName = s.Name;
    }

    private async Task Rename(ApiService s)
    {
        var name = _newName.Trim();
        if (name.Length == 0) { _problems = ["Enter a name."]; return; }
        if (await Api.SaveServiceAsync(s.With(name: name)) is { } error) { _problems = [error]; return; }
        _message = $"Renamed to {name}.";
        Close();
        await Reload();
    }

    private async Task OpenDelete(ApiService s)
    {
        Open(s.Id, Panel.Delete);
        _usage = await Api.GetServiceUsageAsync(s.Id);
        if (_usage is null) { _message = "Couldn't check which endpoints use this service. Try again."; Close(); }
    }

    private async Task DeleteService(ApiService s)
    {
        var error = await Api.DeleteServiceAsync(s.Id);
        _message = error ?? $"Deleted {s.Name}.";
        Close();
        await Reload();
    }

    private async Task Check(ApiService s, AuthProfile profile) => _checks[s.Id] = await Api.CheckSignInAsync(profile.Id);

    private async Task Preview(ApiService s)
    {
        var preview = await Api.PreviewOpenApiAsync(s.Id, _specUrl);
        _candidates = (preview?["endpoints"] as JsonArray)?.Where(n => n is not null).Select(n => n!).ToList();
        _problems = _candidates is null ? [preview?["title"]?.ToString() ?? "Couldn't read that spec."] : [];
        foreach (var c in _candidates ?? []) _selected.Add(c["operationId"]!.ToString());
    }

    private async Task Import(ApiService s)
    {
        var error = await Api.ImportOpenApiAsync(s.Id, _specUrl, _selected.ToArray());
        _message = error ?? $"Imported {_selected.Count} operation(s) into {s.Name}.";
        Close();
        await Reload();
    }
}
