@page "/services"
@inject AdminApiClient Api
@inject ToastService Toasts

<PageShell Title="Services" Purpose="The APIs you can combine into aggregated endpoints, and how the gateway signs in to each." HelpTopic="add-service">
    <Actions>
        @* The page's one primary action, hidden while a form is open (that form's button is the primary then). *@
        @if (_newService is null && _openFor is null) { <button class="button primary" @onclick="StartNewService">Add service</button> }
    </Actions>
</PageShell>

@* ------------------------------------------------------------------ add service: three stages *@
@if (_newService is { } ns)
{
    <section class="card accent" aria-labelledby="add-heading">
        <div class="header-row"><h2 id="add-heading">Add a service</h2><HelpLink Topic="before" Text="What to ask the service owner" /></div>
        <ol class="stepper small" aria-label="Add a service in three stages">
            @foreach (var (n, title) in new[] { (1, "Where it is"), (2, "Name and endpoints"), (3, "Sign-in and check") })
            {
                <li class="@(n < _stage ? "done" : "")"><span class="stage @(n == _stage ? "current" : "")" aria-current="@(n == _stage ? "step" : null)">
                    <span class="num" aria-hidden="true">@(n < _stage ? "✓" : n.ToString())</span>@title</span></li>
            }
        </ol>

        @if (_stage == 1)
        {
            <fieldset class="choice" aria-label="How to add it">
                <button class="kind @(ns.FromSpec ? "selected" : "")" aria-pressed="@ns.FromSpec" @onclick="() => ns.FromSpec = true">
                    <strong>From an OpenAPI spec</strong><span>Recommended. Endpoints, parameters and fields are filled in for you.</span>
                </button>
                <button class="kind @(!ns.FromSpec ? "selected" : "")" aria-pressed="@(!ns.FromSpec)" @onclick="() => ns.FromSpec = false">
                    <strong>Enter by hand</strong><span>For services without a spec. You add its endpoints afterwards.</span>
                </button>
            </fieldset>
            @if (ns.FromSpec)
            {
                <div class="inline">
                    <label class="grow">Spec address <input @bind="ns.SpecUrl" placeholder="https://orders.internal/swagger/v1/swagger.json" /></label>
                    <button class="button" disabled="@_busy" @onclick="LoadSpec">@(_busy ? "Loading…" : "Load")</button>
                </div>
                <p class="hint">Try it with the sample billing service: <code>http://localhost:5100/d/openapi.json</code></p>
            }
        }
        else if (_stage == 2)
        {
            <div class="grid">
                <label>Name <input @bind="ns.Name" placeholder="Orders service" /></label>
                <label>Base address <input @bind="ns.BaseUrl" placeholder="https://orders.internal/api" /></label>
            </div>
            @if (!string.IsNullOrEmpty(ns.Name)) { <p class="hint">Id: <code>@ns.Id</code>. Endpoints refer to the service by this id, so it never changes, even if you rename the service.</p> }
            @if (ns.FromSpec)
            {
                <h3>Operations to import <span class="muted">(@ns.Selected.Count of @ns.Operations.Count)</span></h3>
                <div class="ops">
                    @foreach (var op in ns.Operations)
                    {
                        var id = op["operationId"]!.ToString();
                        <label class="check">
                            <input type="checkbox" checked="@ns.Selected.Contains(id)" @onchange="e => Toggle(ns.Selected, id, (bool)e.Value!)" />
                            <code>@op["method"] @op["path"]</code> <span class="muted">@(op["summary"]?.ToString() ?? id)</span>
                        </label>
                    }
                </div>
            }
            else
            {
                <p class="hint">You'll add its endpoints after saving, with <strong>Add endpoint</strong>.</p>
            }
        }
        else
        {
            <h3>How the gateway signs in <HelpLink Topic="sign-in" Text="Which one do I pick?" /></h3>
            @if (ns.SuggestedSignIn is not null) { <p class="hint">The spec suggests <strong>@SignInKinds.Get(ns.SuggestedSignIn).Title</strong>. Change it if the service owner told you otherwise.</p> }
            <SignInEditor Form="ns.SignIn" ServiceId="@ns.Id" CanSaveSecrets="_canSaveSecrets" />
        }

        <Problems Items="_problems" />
        <div class="inline">
            @if (_stage > 1) { <button class="button" @onclick="() => { _stage--; _problems = []; }">Back</button> }
            @if (_stage < 3) { <button class="button primary" @onclick="Next">Next</button> }
            else { <button class="button primary" disabled="@_busy" @onclick="SaveNewService">@(_busy ? "Saving…" : "Save and check sign-in")</button> }
            <button class="link" @onclick="() => { _newService = null; _problems = []; }">Cancel</button>
        </div>
    </section>
}

@* ------------------------------------------------------------------ existing services *@
@if (_services is null)
{
    <Loading />
}
else if (_services.Count == 0 && _newService is null)
{
    <EmptyState Title="Add your first service">
        <ChildContent><p>A service is an API the gateway calls, such as a customer or orders system. Point at its OpenAPI spec, or enter the address by hand.</p></ChildContent>
        <Action><button class="button" @onclick="StartNewService">Add service</button></Action>
    </EmptyState>
}
else if (_services.Count > 0)
{
    <div class="inline service-tools">
        <label class="search grow">Search services and endpoints
            <input type="search" @bind="_search" @bind:event="oninput" placeholder="For example orders, /customers or getInvoice" />
        </label>
        <button class="button" disabled="@_checkingAll" @onclick="CheckAll">@(_checkingAll ? "Checking…" : "Check all sign-ins")</button>
    </div>
    var shown = _services.Where(MatchesService).ToList();
    <p class="hint" role="status">@(string.IsNullOrWhiteSpace(_search) ? $"{_services.Count} services" : $"{shown.Count} of {_services.Count} services match")</p>
    @if (shown.Count == 0) { <p class="muted">No service or endpoint matches "@_search".</p> }

    @foreach (var s in shown)
    {
        var profile = _profiles.FirstOrDefault(p => p.Id == s.AuthProfileId);
        var signIn = SignInDisplay.For(s, _signIns);
        var endpoints = s.Endpoints.Where(e => MatchesEndpoint(s, e)).ToList();
        var expanded = _expanded.Contains(s.Id) || !string.IsNullOrWhiteSpace(_search);
        <section class="card service" id="service-@s.Id" aria-labelledby="name-@s.Id">
            <div class="header-row">
                <div class="grow">
                    <h2 id="name-@s.Id">@(string.IsNullOrEmpty(s.Name) ? s.Id : s.Name) <StatusPill State="signIn.State" Text="@signIn.Text" Title="@signIn.Message" /></h2>
                    <p class="muted">
                        <code>@s.BaseUrl</code> ·
                        @(profile is null ? "No sign-in" : string.Join(" + ", profile.Steps.Select(st => SignInKinds.Get(st.Kind).Title)))
                        @if (SignInDisplay.Ago(signIn.CheckedAt) is { Length: > 0 } ago) { <span> · @ago</span> }
                    </p>
                </div>
                <div class="inline">
                    <button class="button" @onclick="() => Open(s.Id, Panel.Endpoint)">Add endpoint</button>
                    <button class="button" @onclick="() => OpenSignIn(s, profile)">Sign-in</button>
                    @if (profile is not null) { <button class="button" disabled="@_checking.Contains(s.Id)" @onclick="() => Check(s, profile)">@(_checking.Contains(s.Id) ? "Checking…" : "Check sign-in")</button> }
                    <details class="more">
                        <summary class="button">More<span class="visually-hidden"> actions for @s.Name</span></summary>
                        <div class="menu">
                            <button class="link" @onclick="() => Open(s.Id, Panel.Import)">Import from OpenAPI</button>
                            <button class="link" @onclick="() => OpenRename(s)">Rename</button>
                            <button class="link danger-text" @onclick="() => OpenDelete(s)">Delete service</button>
                        </div>
                    </details>
                </div>
            </div>

            @if (signIn.State == StatusPill.Kind.Bad)
            {
                <ErrorBanner Message="@($"Sign-in failed: {signIn.Message}")" HelpTopic="troubleshooting" />
            }

            @if (s.Endpoints.Count == 0)
            {
                <p class="muted">No endpoints yet. Use <strong>Add endpoint</strong>, or <strong>More › Import from OpenAPI</strong>.</p>
            }
            else
            {
                <button class="link" aria-expanded="@expanded" aria-controls="endpoints-@s.Id" @onclick="() => ToggleExpanded(s.Id)">
                    @(expanded ? "Hide" : "Show") @(string.IsNullOrWhiteSpace(_search) ? $"{s.Endpoints.Count} endpoint{(s.Endpoints.Count == 1 ? "" : "s")}" : $"{endpoints.Count} matching endpoint{(endpoints.Count == 1 ? "" : "s")}")
                </button>
                @if (expanded)
                {
                    <table class="list" id="endpoints-@s.Id">
                        <caption class="visually-hidden">Endpoints of @s.Name</caption>
                        <thead><tr><th scope="col">Endpoint</th><th scope="col">Call</th><th scope="col">Values it needs</th><th scope="col">Fields known</th><th scope="col"><span class="visually-hidden">Remove</span></th></tr></thead>
                        <tbody>
                            @foreach (var e in endpoints)
                            {
                                <tr>
                                    <td>@(e.Summary ?? Slug.Humanize(e.Id))</td>
                                    <td><code>@e.Method @e.Path</code></td>
                                    <td>@(e.Parameters.Count == 0 ? "None" : string.Join(", ", e.Parameters.Select(p => $"{p.Name} ({p.In}{(p.Required ? ", required" : "")})")))</td>
                                    <td>@(e.ResponseSchema is null ? "No" : "Yes")</td>
                                    <td><button class="link" @onclick="() => _confirmRemove = (s.Id, e.Id)">Remove<span class="visually-hidden"> @(e.Summary ?? e.Id)</span></button></td>
                                </tr>
                                @if (_confirmRemove == (s.Id, e.Id))
                                {
                                    <tr><td colspan="5">
                                        <ConfirmBox Danger="true" ConfirmText="Remove endpoint" OnConfirm="() => RemoveEndpoint(s, e)" OnCancel="() => _confirmRemove = null">
                                            <p>Remove <strong>@(e.Summary ?? e.Id)</strong> from @s.Name? Aggregated endpoints that call it will show a problem until you change them.</p>
                                        </ConfirmBox>
                                    </td></tr>
                                }
                            }
                        </tbody>
                    </table>
                    <p class="hint">"Fields known" means the wizard can offer this endpoint's response fields in its dropdowns.</p>
                }
            }

            @* --- add endpoint by hand *@
            @if (_openFor == s.Id && _panel == Panel.Endpoint)
            {
                <div class="panel">
                    <h3>Add an endpoint <HelpLink Topic="add-endpoint" /></h3>
                    <div class="grid">
                        <label>Name <input @bind="_newEndpoint.Name" placeholder="Get order lines" /></label>
                        <label>Method
                            <select @bind="_newEndpoint.Method">
                                @foreach (var m in new[] { "GET", "POST", "PUT", "PATCH", "DELETE" }) { <option>@m</option> }
                            </select>
                        </label>
                        <label class="grow">Path <input @bind="_newEndpoint.Path" @bind:event="oninput" placeholder="/orders/{orderId}/lines" /></label>
                    </div>
                    @if (_newEndpoint.PathParams.Any())
                    {
                        <p class="hint">Path values: @string.Join(", ", _newEndpoint.PathParams) (required)</p>
                    }
                    @if (_newEndpoint.Parameters.Count > 0)
                    {
                        <table class="list">
                            <thead><tr><th scope="col">Other value</th><th scope="col">Sent as</th><th scope="col">Required</th><th scope="col"><span class="visually-hidden">Remove</span></th></tr></thead>
                            <tbody>
                                @foreach (var p in _newEndpoint.Parameters)
                                {
                                    <tr>
                                        <td><input @bind="p.Name" placeholder="status or X-Customer-Id" aria-label="Value name" /></td>
                                        <td><select @bind="p.In" aria-label="Sent as"><option>query</option><option>header</option><option>cookie</option></select></td>
                                        <td><input type="checkbox" @bind="p.Required" aria-label="Required" /></td>
                                        <td><button class="link" @onclick="() => _newEndpoint.Parameters.Remove(p)">Remove</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <button class="link" @onclick="() => _newEndpoint.Parameters.Add(new ParamRow())">Add a query or header value</button>
                    <label>Sample response (optional, lets the wizard offer its fields)
                        <textarea rows="5" @bind="_newEndpoint.SampleResponse" placeholder='{ "id": "O-1", "total": 20.5, "items": [ { "sku": "A" } ] }'></textarea>
                    </label>
                    <Problems Items="_problems" />
                    <div class="inline">
                        <button class="button primary" @onclick="() => SaveEndpoint(s)">Add endpoint</button>
                        <button class="link" @onclick="Close">Cancel</button>
                    </div>
                </div>
            }

            @* --- sign-in *@
            @if (_openFor == s.Id && _panel == Panel.SignIn && _signIn is not null)
            {
                <div class="panel">
                    <h3>How the gateway signs in to @s.Name <HelpLink Topic="sign-in" Text="Which one do I pick?" /></h3>
                    <SignInEditor Form="_signIn" ServiceId="@s.Id" CanSaveSecrets="_canSaveSecrets" />
                    <Problems Items="_problems" />
                    <div class="inline">
                        <button class="button primary" @onclick="() => SaveSignIn(s, profile)">Save and check sign-in</button>
                        <button class="link" @onclick="Close">Cancel</button>
                    </div>
                </div>
            }

            @* --- rename *@
            @if (_openFor == s.Id && _panel == Panel.Rename)
            {
                <div class="panel">
                    <h3>Rename @s.Name <HelpLink Topic="delete" /></h3>
                    <div class="inline">
                        <label class="grow">Display name <input @bind="_newName" maxlength="100" /></label>
                        <button class="button primary" @onclick="() => Rename(s)">Save name</button>
                        <button class="link" @onclick="Close">Cancel</button>
                    </div>
                    <p class="hint">Only the name people see changes. The id <code>@s.Id</code> stays the same, so endpoints that use this service keep working.</p>
                    <Problems Items="_problems" />
                </div>
            }

            @* --- delete *@
            @if (_openFor == s.Id && _panel == Panel.Delete && _usage is { } usage)
            {
                <div class="panel">
                    @if (usage.Published.Count > 0)
                    {
                        <div class="banner error" role="alert">
                            <span class="pill-icon" aria-hidden="true">✕</span>
                            <div class="grow">
                                <p><strong>@s.Name can't be deleted yet.</strong> These published endpoints still call it. Change them to use another service, or delete them, first:</p>
                                <ul>@foreach (var r in usage.Published) { <li><a href="/endpoints/@r.Id">@r.Name</a></li> }</ul>
                            </div>
                            <button class="link" @onclick="Close">Close</button>
                        </div>
                    }
                    else
                    {
                        <ConfirmBox Danger="true" ConfirmText="@($"Delete {s.Name}")" OnConfirm="() => DeleteService(s)" OnCancel="Close">
                            <p>@s.Name and its @s.Endpoints.Count endpoint(s) are removed from this list. No published endpoint uses it.</p>
                            @if (usage.Drafts.Count > 0)
                            {
                                <p>These <strong>drafts</strong> use it and will show a problem until you change them:</p>
                                <ul>@foreach (var r in usage.Drafts) { <li><a href="/endpoints/@r.Id">@r.Name</a></li> }</ul>
                            }
                            @if (profile is not null) { <p class="hint">Its sign-in settings are kept, because another service may use them.</p> }
                        </ConfirmBox>
                    }
                </div>
            }

            @* --- import *@
            @if (_openFor == s.Id && _panel == Panel.Import)
            {
                <div class="panel">
                    <h3>Import endpoints from a spec</h3>
                    <div class="inline">
                        <label class="grow">Spec address <input @bind="_specUrl" placeholder="https://service/openapi.json" /></label>
                        <button class="button" @onclick="() => Preview(s)">Load operations</button>
                    </div>
                    @if (_candidates is not null)
                    {
                        <p class="hint">Existing endpoints with the same id are updated, not duplicated.</p>
                        <div class="ops">
                            @foreach (var c in _candidates)
                            {
                                var id = c["operationId"]!.ToString();
                                <label class="check">
                                    <input type="checkbox" checked="@_selected.Contains(id)" @onchange="e => Toggle(_selected, id, (bool)e.Value!)" />
                                    <code>@c["method"] @c["path"]</code> <span class="muted">@(c["summary"]?.ToString() ?? id)</span>
                                </label>
                            }
                        </div>
                    }
                    <Problems Items="_problems" />
                    <div class="inline">
                        @if (_candidates is not null) { <button class="button primary" @onclick="() => Import(s)">Import @_selected.Count operation(s)</button> }
                        <button class="link" @onclick="Close">Cancel</button>
                    </div>
                </div>
            }
        </section>
    }
}

@code {
    private enum Panel { None, Endpoint, SignIn, Import, Rename, Delete }

    /// <summary>"/services?add=1" opens Add service straight away (the Home page's quick action).</summary>
    [SupplyParameterFromQuery(Name = "add")] public int? AddFromQuery { get; set; }

    private List<ApiService>? _services;
    private List<AuthProfile> _profiles = [];
    private List<SignInStatusRow> _signIns = [];
    private bool _canSaveSecrets;
    private NewServiceForm? _newService;
    private int _stage = 1;
    private NewEndpointForm _newEndpoint = new();
    private SignInForm? _signIn;
    private string? _openFor;
    private Panel _panel;
    private string _specUrl = "";
    private List<JsonNode>? _candidates;
    private readonly HashSet<string> _selected = [];
    private readonly HashSet<string> _expanded = [];
    private readonly HashSet<string> _checking = [];
    private bool _checkingAll, _busy;
    private List<string> _problems = [];
    private string _newName = "";
    private ServiceUsage? _usage;
    private (string Service, string Endpoint)? _confirmRemove;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        _canSaveSecrets = await Api.CanSaveSecretsAsync();
        await Reload();
        if (AddFromQuery == 1) StartNewService();
    }

    private async Task Reload()
    {
        _services = await Api.GetServicesAsync() ?? [];
        _profiles = await Api.GetAuthProfilesAsync() ?? [];
        _signIns = await Api.GetSignInStatusAsync() ?? [];
    }

    // ------------------------------------------------------------------ search

    private bool MatchesService(ApiService s) =>
        string.IsNullOrWhiteSpace(_search) || Has($"{s.Name} {s.Id} {s.BaseUrl}") || s.Endpoints.Any(e => MatchesEndpoint(s, e));

    private bool MatchesEndpoint(ApiService s, ApiEndpoint e) =>
        string.IsNullOrWhiteSpace(_search) || Has($"{s.Name} {s.Id}") || Has($"{e.Summary} {e.Id} {e.Method} {e.Path}");

    private bool Has(string text) => text.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase);

    private void ToggleExpanded(string id) { if (!_expanded.Remove(id)) _expanded.Add(id); }

    // ------------------------------------------------------------------ panels

    private void Open(string serviceId, Panel panel)
    {
        _openFor = serviceId; _panel = panel; _problems = [];
        _newEndpoint = new NewEndpointForm();
        _candidates = null; _selected.Clear();
        _specUrl = _services?.FirstOrDefault(s => s.Id == serviceId)?.OpenApiSource ?? "";
    }

    private void Close() { _openFor = null; _panel = Panel.None; _problems = []; }

    private static void Toggle(HashSet<string> set, string id, bool on) { if (on) set.Add(id); else set.Remove(id); }

    // ------------------------------------------------------------------ add service

    private void StartNewService() { _newService = new NewServiceForm(); _stage = 1; _problems = []; Close(); }

    private async Task LoadSpec()
    {
        var ns = _newService!;
        _busy = true;
        try
        {
            var preview = await Api.PreviewOpenApiAsync("new", ns.SpecUrl);
            if (preview?["endpoints"] is null) { _problems = [preview?["title"]?.ToString() ?? "Couldn't read that spec. Check the address."]; return; }
            ns.ApplyPreview(preview);
            _problems = [];
            _stage = 2; // loaded: straight on to the name and the operations
        }
        finally { _busy = false; }
    }

    private void Next()
    {
        var ns = _newService!;
        _problems = (_stage == 1 ? ns.SourceProblems() : ns.DetailProblems()).ToList();
        if (_stage == 2 && _services!.Any(s => s.Id == ns.Id)) _problems.Add($"A service with id '{ns.Id}' already exists. Pick another name.");
        if (_problems.Count == 0) _stage++;
    }

    private async Task SaveNewService()
    {
        var ns = _newService!;
        _problems = ns.Problems().ToList();
        if (_services!.Any(s => s.Id == ns.Id)) _problems.Add($"A service with id '{ns.Id}' already exists. Pick another name.");
        if (_problems.Count > 0) return;

        _busy = true;
        try
        {
            var profile = ns.SignIn.ToProfile($"{ns.Id}-signin", ns.Id, ns.Name, out var secrets);
            if (await SaveSignInParts(profile, secrets) is { } error) { _problems = [error]; return; }

            var service = new ApiService { Id = ns.Id, Name = ns.Name.Trim(), BaseUrl = ns.BaseUrl.Trim(), AuthProfileId = profile?.Id, TimeoutMs = ns.TimeoutMs, OpenApiSource = ns.FromSpec ? ns.SpecUrl : null };
            if (await Api.SaveServiceAsync(service) is { } saveError) { _problems = [saveError]; return; }
            if (ns.FromSpec && await Api.ImportOpenApiAsync(service.Id, ns.SpecUrl, ns.Selected.ToArray()) is { } importError) { _problems = [importError]; return; }

            Toasts.Success($"{service.Name} added{(ns.FromSpec ? $" with {ns.Selected.Count} endpoint(s)" : ". Add its endpoints next")}.");
            _newService = null;
            _expanded.Add(service.Id);
            await Reload();
            if (profile is not null) await Check(service, profile);
        }
        finally { _busy = false; }
    }

    // ------------------------------------------------------------------ endpoints, sign-in, import

    private async Task SaveEndpoint(ApiService s)
    {
        _problems = _newEndpoint.Problems(s).ToList();
        if (_problems.Count > 0) return;
        var endpoint = _newEndpoint.ToEndpoint();
        if (await Api.SaveServiceAsync(s.With(s.Endpoints.Append(endpoint).ToList())) is { } error) { _problems = [error]; return; }
        Toasts.Success($"Added {endpoint.Summary} to {s.Name}.");
        Close();
        _expanded.Add(s.Id);
        await Reload();
    }

    private async Task RemoveEndpoint(ApiService s, ApiEndpoint e)
    {
        var error = await Api.SaveServiceAsync(s.With(s.Endpoints.Where(x => x.Id != e.Id).ToList()));
        _confirmRemove = null;
        if (error is not null) { Toasts.Error(error); return; }
        Toasts.Success($"Removed {e.Summary ?? e.Id}. Endpoints that used it will show a problem until you change them.");
        await Reload();
    }

    private void OpenSignIn(ApiService s, AuthProfile? profile)
    {
        Open(s.Id, Panel.SignIn);
        _signIn = SignInForm.From(profile);
    }

    private async Task SaveSignIn(ApiService s, AuthProfile? existing)
    {
        _problems = _signIn!.Problems().ToList();
        if (_problems.Count > 0) return;

        var profile = _signIn.ToProfile(existing?.Id ?? $"{s.Id}-signin", s.Id, s.Name, out var secrets);
        if (await SaveSignInParts(profile, secrets) is { } error) { _problems = [error]; return; }
        if (await Api.SaveServiceAsync(s.With(authProfileId: profile?.Id, clearAuth: profile is null)) is { } saveError) { _problems = [saveError]; return; }

        Close();
        await Reload();
        if (profile is not null) await Check(s, profile); else Toasts.Success($"{s.Name} now has no sign-in.");
    }

    /// <summary>Secrets first (Development only), then the profile, so the profile never points at a missing secret.</summary>
    private async Task<string?> SaveSignInParts(AuthProfile? profile, Dictionary<string, string> secrets)
    {
        if (profile is null) return null;
        if (_canSaveSecrets)
            foreach (var (name, value) in secrets)
                if (await Api.SaveSecretAsync(name, value) is { } error) return error;
        return await Api.SaveAuthProfileAsync(profile);
    }

    private async Task Check(ApiService s, AuthProfile profile)
    {
        _checking.Add(s.Id);
        try
        {
            var (ok, message) = await Api.CheckSignInAsync(profile.Id);
            _signIns = await Api.GetSignInStatusAsync() ?? _signIns;
            if (ok) Toasts.Success($"{s.Name}: {message}");
            else Toasts.Error($"{s.Name}: sign-in failed. {message}", "What does this mean?", "/help#troubleshooting");
        }
        finally { _checking.Remove(s.Id); }
    }

    private async Task CheckAll()
    {
        _checkingAll = true;
        var result = await Api.CheckAllSignInsAsync();
        _checkingAll = false;
        if (result is null) { Toasts.Error("Couldn't check the sign-ins. Is the admin API running?"); return; }
        _signIns = result;
        var failed = result.Count(r => r.State == "failed");
        if (failed == 0) Toasts.Success("Every sign-in works, or is ready for its first call.");
        else Toasts.Error($"{failed} sign-in{(failed == 1 ? "" : "s")} failed. Each one is marked Failed, with the reason.");
    }

    private async Task Preview(ApiService s)
    {
        var preview = await Api.PreviewOpenApiAsync(s.Id, _specUrl);
        _candidates = (preview?["endpoints"] as JsonArray)?.Where(n => n is not null).Select(n => n!).ToList();
        _problems = _candidates is null ? [preview?["title"]?.ToString() ?? "Couldn't read that spec."] : [];
        foreach (var c in _candidates ?? []) _selected.Add(c["operationId"]!.ToString());
    }

    private async Task Import(ApiService s)
    {
        var error = await Api.ImportOpenApiAsync(s.Id, _specUrl, _selected.ToArray());
        if (error is not null) { _problems = [error]; return; }
        Toasts.Success($"Imported {_selected.Count} operation(s) into {s.Name}.");
        Close();
        _expanded.Add(s.Id);
        await Reload();
    }

    // ------------------------------------------------------------------ rename, delete

    private void OpenRename(ApiService s)
    {
        Open(s.Id, Panel.Rename);
        _newName = s.Name;
    }

    private async Task Rename(ApiService s)
    {
        var name = _newName.Trim();
        if (name.Length == 0) { _problems = ["Enter a name."]; return; }
        if (await Api.SaveServiceAsync(s.With(name: name)) is { } error) { _problems = [error]; return; }
        Toasts.Success($"Renamed to {name}. Endpoints that use it keep working.");
        Close();
        await Reload();
    }

    private async Task OpenDelete(ApiService s)
    {
        Open(s.Id, Panel.Delete);
        _usage = await Api.GetServiceUsageAsync(s.Id);
        if (_usage is null) { Toasts.Error("Couldn't check which endpoints use this service. Try again."); Close(); }
    }

    private async Task DeleteService(ApiService s)
    {
        var error = await Api.DeleteServiceAsync(s.Id);
        Close();
        if (error is not null) { Toasts.Error(error); return; }
        Toasts.Success($"Deleted {s.Name}.");
        await Reload();
    }
}
