@page "/endpoints/new"
@page "/endpoints/{Id}"
@using System.Text.RegularExpressions
@using ApiAggregator.Engine.Planning
@inject AdminApiClient Api
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>@(IsNew ? "New endpoint" : _form.Name)</PageTitle>

@if (_snapshot is null)
{
    <p class="muted">Loading…</p>
    return;
}

<div class="header-row"><h1>@(IsNew ? "New aggregated endpoint" : _form.Name)</h1><HelpLink Topic="build" Text="How to build an endpoint" /></div>
<p class="muted">Address: <code>@_form.Method /bff/@_form.Route.Trim('/')</code></p>
@if (_deleted)
{
    <div class="issues warnings">
        <strong>This endpoint is deleted.</strong> The gateway doesn't serve it. Its last version is shown below.
        To bring it back, choose <strong>Roll back to this</strong> under <a href="#history">History</a>, or change it, test it and publish. <HelpLink Topic="history" />
    </div>
}

@* ------------------------------------------------------------------ 1. Endpoint *@
<section class="card">
    <h2>1. Endpoint</h2>
    <div class="grid">
        <label>Name <input value="@_form.Name" @onchange="e => OnNameChanged(e.Value?.ToString())" placeholder="Customer overview" /></label>
        <label>Id <input @bind="_form.Id" disabled="@(!IsNew)" placeholder="customer-overview" /></label>
        <label>Method
            <select @bind="_form.Method">
                @foreach (var m in new[] { "GET", "POST", "PUT", "PATCH", "DELETE" }) { <option>@m</option> }
            </select>
        </label>
        <label>Route <input value="@_form.Route" @onchange="e => OnRouteChanged(e.Value?.ToString())" placeholder="customer/{id}/overview" /></label>
    </div>
    <div class="grid">
        <label class="check"><input type="checkbox" @bind="_form.RequireAuthentication" /> Callers must sign in</label>
        <label>Required scope <input @bind="_form.RequiredScope" placeholder="customer.read" /></label>
        <label class="check"><input type="checkbox" @bind="_form.CacheEnabled" /> Cache responses</label>
        @if (_form.CacheEnabled)
        {
            <label>Keep for (seconds) <input type="number" min="1" max="86400" @bind="_form.CacheTtlSeconds" /></label>
        }
    </div>
    @if (_form.CacheEnabled) { <p class="hint">Each caller gets their own cached copy, so nobody can see another person's data.</p> }
</section>

@* ------------------------------------------------------------------ 2. Inputs *@
<section class="card">
    <h2>2. Inputs <HelpLink Topic="build" /></h2>
    <p class="hint">What the caller sends. Anything not listed here is ignored and never passed on.</p>
    <table class="list">
        <thead><tr><th>From</th><th>Name</th><th>Type</th><th>Required</th><th>Default</th><th>Test value</th><th></th></tr></thead>
        <tbody>
            @foreach (var input in _form.Inputs)
            {
                <tr>
                    <td>
                        <select @bind="input.Source">
                            <option value="route">route</option><option value="query">query</option><option value="header">header</option>
                        </select>
                    </td>
                    <td><input @bind="input.Name" /></td>
                    <td>
                        <select @bind="input.Type">
                            @foreach (var t in new[] { "string", "int", "number", "bool", "date" }) { <option>@t</option> }
                        </select>
                    </td>
                    <td><input type="checkbox" @bind="input.Required" /></td>
                    <td><input @bind="input.Default" /></td>
                    <td><input @bind="input.TestValue" placeholder="for Try it" /></td>
                    <td><button class="link" @onclick="() => _form.Inputs.Remove(input)">Remove</button></td>
                </tr>
            }
        </tbody>
    </table>
    <button class="button" @onclick="() => _form.Inputs.Add(new InputForm())">Add input</button>
</section>

@* ------------------------------------------------------------------ 3. Steps *@
<section class="card">
    <h2>3. Steps <HelpLink Topic="build" /></h2>
    <p class="hint">Each step calls one service endpoint. Fill each value from the caller's inputs or from an earlier step. The run order is worked out for you.</p>

    @for (var i = 0; i < _form.Steps.Count; i++)
    {
        var step = _form.Steps[i];
        var number = i + 1;
        <div class="step">
            <div class="header-row">
                <input class="step-name" value="@step.DisplayName" @onchange="e => step.DisplayName = e.Value?.ToString() ?? step.DisplayName" />
                <button class="link" @onclick="() => _form.Steps.Remove(step)">Remove step</button>
            </div>

            <label>Calls
                <select value="@step.Endpoint" @onchange="e => OnEndpointChanged(step, e.Value?.ToString())">
                    <option value="">Pick a service endpoint…</option>
                    @foreach (var s in _snapshot.Services.OrderBy(s => s.Name))
                    {
                        <optgroup label="@s.Name">
                            @foreach (var ep in s.Endpoints) { <option value="@($"{s.Id}/{ep.Id}")">@ep.Method @ep.Path @(ep.Summary is null ? "" : $"· {ep.Summary}")</option> }
                        </optgroup>
                    }
                </select>
            </label>

            @if (step.Bindings.Count > 0)
            {
                var sources = SourcesFor(step);
                <table class="list bindings">
                    <thead><tr><th>Value</th><th>Sent as</th><th>Use value from</th></tr></thead>
                    <tbody>
                        @foreach (var (target, binding) in step.Bindings.OrderBy(b => b.Key))
                        {
                            var parts = target.Split('.', 2);
                            <tr>
                                <td>@parts[1]</td>
                                <td><span class="tag">@parts[0]</span></td>
                                <td>
                                    @if (binding.Suggested) { <span class="tag suggested" title="@binding.Reason">suggested</span> }
                                    <select value="@SelectValue(binding)" @onchange="e => OnBindingChanged(binding, e.Value?.ToString())">
                                        <option value="none">Leave empty</option>
                                        @foreach (var group in sources.GroupBy(o => o.Group))
                                        {
                                            <optgroup label="@group.Key">
                                                @foreach (var o in group) { <option value="@($"src:{o.Expression}")">@o.Label</option> }
                                            </optgroup>
                                        }
                                        <option value="fixed">Fixed value…</option>
                                    </select>
                                    @if (binding.Mode == BindingMode.FixedValue)
                                    {
                                        <input @bind="binding.FixedValue" placeholder="Type the value" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="inline">
                    <input @bind="_extraTarget[number]" placeholder="header.X-Something or query.name" />
                    <button class="link" @onclick="() => AddExtraValue(step, number)">Add another value</button>
                </div>
            }

            @if (RunsAfter(step) is { Length: > 0 } after) { <p class="hint">Runs after @after</p> }

            <button class="link" @onclick="() => step.ShowAdvanced = !step.ShowAdvanced">@(step.ShowAdvanced ? "Hide advanced" : "Advanced")</button>
            @if (step.ShowAdvanced)
            {
                <div class="grid">
                    <label class="check"><input type="checkbox" @bind="step.Required" /> If this call fails, fail the whole endpoint</label>
                    <label>Only run when <input @bind="step.When" placeholder="{{getCustomer.body.isPremium}} == true" /></label>
                    <label>Run once for each item in <input @bind="step.ForEach" placeholder="{{getOrders.body.items[0:3].id}}" /></label>
                    @if (!string.IsNullOrWhiteSpace(step.ForEach))
                    {
                        <label class="check"><input type="checkbox" @bind="step.Distinct" /> Call once per unique item</label>
                    }
                    <label class="check"><input type="checkbox" @bind="step.CacheEnabled" /> Cache this call</label>
                    @if (step.CacheEnabled) { <label>Keep for (seconds) <input type="number" min="1" @bind="step.CacheTtlSeconds" /></label> }
                </div>
            }
        </div>
    }
    @if (!_picking)
    {
        <button class="button primary" @onclick="() => { _picking = true; _search = string.Empty; }">Add step</button>
    }
    else
    {
        <div class="picker">
            <div class="inline">
                <input class="grow" @bind="_search" @bind:event="oninput" placeholder="Search endpoints, e.g. orders" />
                <button class="link" @onclick="() => _picking = false">Close</button>
            </div>
            @foreach (var s in _snapshot.Services.OrderBy(s => s.Name))
            {
                var matches = s.Endpoints.Where(e => Matches(s, e)).ToList();
                if (matches.Count == 0) continue;
                <h3>@s.Name</h3>
                @foreach (var ep in matches)
                {
                    <div class="picker-row">
                        <div><strong>@(ep.Summary ?? Slug.Humanize(ep.Id))</strong> <code class="muted">@ep.Method @ep.Path</code></div>
                        <button class="button" @onclick="() => AddStep(s, ep)">Add</button>
                    </div>
                }
            }
            @if (_snapshot.Services.All(s => s.Endpoints.Count == 0)) { <p class="muted">No endpoints yet. <a href="/services">Add a service</a> first.</p> }
        </div>
    }
    @if (_form.Steps.Count > 0) { <p class="hint">Values marked <span class="tag suggested">suggested</span> were filled in for you. Check them, then try it in step 5.</p> }
</section>

@* ------------------------------------------------------------------ 4. Response *@
<section class="card">
    <h2>4. Response</h2>

    @* ---- combine lists: merge records that appear in several services *@
    <div class="combine-card">
        <div class="header-row"><h3>Combine lists <HelpLink Topic="combine" /></h3></div>
        <p class="hint">Do the same records (for example customers) come back from more than one service? Combine them into one list with each record once. Then add the result to the response below.</p>
        @{ var lists = ListOptions.For(_form, _snapshot); }
        @foreach (var combine in _form.Combines.ToList())
        {
            <CombineEditor Form="combine" Lists="lists" Changed="StateHasChanged" Removed="() => _form.Combines.Remove(combine)" AddToResponse="() => AddCombineToResponse(combine)" />
        }
        <button class="button" disabled="@(_form.Steps.Count == 0)" @onclick="AddCombine">Combine lists</button>
        @if (_form.Steps.Count == 0) { <span class="hint">Add steps first.</span> }
    </div>

    <h3>Response fields</h3>
    <p class="hint">Choose what the caller gets back. With no fields, each step's full response (and each combined list) is returned under its name. Once you add a field, only the fields listed here are returned.</p>
    @{ var allSources = SourcesFor(null); }
    <table class="list">
        <thead><tr><th>Field name</th><th>Value</th><th></th></tr></thead>
        <tbody>
            @foreach (var field in _form.Response)
            {
                <tr>
                    <td><input @bind="field.Name" /></td>
                    <td>
                        <select @bind="field.Expression">
                            <option value="">Pick a value…</option>
                            @foreach (var o in allSources) { <option value="@o.Expression">@o.Label</option> }
                        </select>
                    </td>
                    <td><button class="link" @onclick="() => _form.Response.Remove(field)">Remove</button></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="inline">
        @foreach (var step in _form.Steps)
        {
            <button class="button" @onclick="() => AddFieldsFrom(step)">Add fields from @step.DisplayName</button>
        }
        <button class="link" @onclick="() => _form.Response.Add(new ResponseField())">Add one field</button>
        @if (_form.Response.Count > 0) { <button class="link" @onclick="() => _form.Response.Clear()">Clear (return everything)</button> }
    </div>
</section>

@* ------------------------------------------------------------------ 5. Test and publish *@
<section class="card">
    <h2>5. Test and publish <HelpLink Topic="publish" /></h2>

    @if (Issues.Count > 0)
    {
        <div class="issues">
            <strong>Things to fix</strong> <HelpLink Topic="troubleshooting" Text="What do these mean?" />
            <ul>@foreach (var issue in Issues) { <li><code>@issue.Where</code> @issue.Message</li> }</ul>
        </div>
    }

    @if (Warnings.Count > 0)
    {
        <div class="issues warnings">
            <strong>Check before publishing</strong>
            <ul>@foreach (var warning in Warnings) { <li><code>@warning.Where</code> @warning.Message</li> }</ul>
        </div>
    }

    <div class="inline">
        <button class="button" @onclick="SaveDraft">Save draft</button>
        <button class="button" @onclick="RunTest">Try it</button>
        <button class="button primary" @onclick="Publish">Publish</button>
    </div>

    @if (_test is not null)
    {
        <p class="@(_test.Passed ? "ok" : "bad")">
            @(_test.Passed ? "Test passed" : "Test didn't pass") · HTTP @_test.StatusCode · @_test.DurationMs ms @(_test.Partial ? "· partial response" : "")
        </p>
        @if (!string.IsNullOrEmpty(_test.CorrelationId))
        {
            <p class="hint"><a href="/logs?correlation=@Uri.EscapeDataString(_test.CorrelationId)">See logs for this test</a></p>
        }
        @if (_test.Trace is { Count: > 0 })
        {
            <table class="list">
                <thead><tr><th>Step</th><th>Result</th><th>Status</th><th>Time</th><th>Call</th><th>Note</th></tr></thead>
                <tbody>
                    @foreach (var t in _test.Trace)
                    {
                        <tr>
                            <td>@(t.DisplayName ?? t.Alias)</td><td>@t.Outcome</td><td>@t.HttpStatus</td><td>@t.DurationMs ms</td>
                            <td><code>@t.Request</code> @(t.Calls > 1 ? $"×{t.Calls}" : "")</td><td>
                                @t.Message
                                @if (t.Detail is not null) { <span> — @t.Detail</span> }
                                @if (t.ErrorCode is not null) { <span class="tag" title="@(t.Retryable ? "Worth trying again later" : "Trying again won't help")">@t.ErrorCode</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (_test.Body is not null) { <pre class="json">@_test.Body.ToJsonString(new JsonSerializerOptions { WriteIndented = true })</pre> }
    }

    @if (_status is not null)
    {
        <p class="status">@_status
            @if (_justPublished)
            {
                <text> </text><a href="@DocsLink" target="_blank" rel="noopener">Try it in API docs</a>
            }
        </p>
    }
</section>

@* ------------------------------------------------------------------ History, discard, delete *@
@if (!IsNew)
{
    <section class="card" id="history">
        <h2>History <HelpLink Topic="history" /></h2>
        @if (_history is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (_history.Count == 0)
        {
            <p class="muted">
                @if (_liveVersion is { } live)
                {
                    <span>v@(live) is live, but it was added straight to the config files, so it has no history yet. The next publish starts it.</span>
                }
                else
                {
                    <span>Not published yet. Every version you publish is kept here, so you can look at it or go back to it later.</span>
                }
            </p>
        }
        else
        {
            <table class="list">
                <thead><tr><th>Version</th><th>What happened</th><th>When</th><th>Who</th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in _history)
                    {
                        <tr>
                            <td>v@(row.Version) @if (row.IsLive) { <span class="tag live">live</span> }</td>
                            <td>@Describe(row)</td>
                            <td>@When(row.At)</td>
                            <td>@(row.By ?? "Not recorded")</td>
                            <td>
                                @if (row.Action != HistoryAction.Unpublished)
                                {
                                    <button class="link" @onclick="() => ToggleView(row.Version)">@(_viewing == row.Version ? "Hide" : "View")</button>
                                    @if (_caps.CanPublish && !row.IsLive)
                                    {
                                        <text> · </text><button class="link" @onclick="() => { _confirmRollBack = row.Version; _confirm = Confirm.None; }">Roll back to this</button>
                                    }
                                }
                            </td>
                        </tr>
                        @if (_viewing == row.Version && _viewed is { } v)
                        {
                            <tr><td colspan="5">
                                <div class="history-view">
                                    <p><strong>@(string.IsNullOrEmpty(v.Name) ? v.Id : v.Name)</strong> · <code>@v.Method /bff/@v.Route</code> · @(v.RequireAuthentication ? $"sign-in required{(string.IsNullOrEmpty(v.RequiredScope) ? "" : $", scope {v.RequiredScope}")}" : "no sign-in")</p>
                                    <p class="hint">Steps: @string.Join(", ", v.Steps.Select(st => $"{st.DisplayName ?? st.Alias} ({st.Endpoint})"))@(v.Combine.Count > 0 ? $" · combined lists: {string.Join(", ", v.Combine.Keys)}" : "")</p>
                                    <pre class="json">@JsonSerializer.Serialize(v, AggregatorJson.Options)</pre>
                                </div>
                            </td></tr>
                        }
                        @if (_confirmRollBack == row.Version)
                        {
                            <tr><td colspan="5">
                                <ConfirmBox ConfirmText="@($"Roll back to v{row.Version}")" OnConfirm="() => RollBack(row.Version)" OnCancel="() => _confirmRollBack = null">
                                    <p>Version @row.Version goes live again as a <strong>new</strong> version, v@(NextVersion). Callers get it within a few seconds. Nothing in the history is removed@(_hasDraft ? ", and your unpublished changes are kept" : "").</p>
                                </ConfirmBox>
                            </td></tr>
                        }
                    }
                </tbody>
            </table>
            @if (!_caps.CanPublish) { <p class="hint">Only publishers can roll back or delete an endpoint. Ask a publisher if you need one of those.</p> }
        }

        @if (_hasDraft || (_liveVersion is not null && _caps.CanPublish))
        {
            <div class="danger-zone">
                <h3>Discard or delete <HelpLink Topic="delete" /></h3>
                <div class="inline">
                    @if (_hasDraft) { <button class="button" @onclick="() => { _confirm = Confirm.Discard; _confirmRollBack = null; }">Discard unpublished changes</button> }
                    @if (_caps.CanPublish && (_liveVersion is not null || _hasDraft)) { <button class="button" @onclick="() => { _confirm = Confirm.Delete; _confirmRollBack = null; }">Delete endpoint</button> }
                </div>
                @if (_confirm == Confirm.Discard)
                {
                    <ConfirmBox ConfirmText="Discard changes" OnConfirm="DiscardDraft" OnCancel="() => _confirm = Confirm.None">
                        @if (_liveVersion is { } live)
                        {
                            <p>Your unpublished changes are removed. The live version, v@(live), keeps serving and opens here.</p>
                        }
                        else
                        {
                            <p>This endpoint was never published@(_history?.Count > 0 ? " since it was deleted" : ""), so the whole draft is removed.</p>
                        }
                    </ConfirmBox>
                }
                @if (_confirm == Confirm.Delete)
                {
                    <ConfirmBox Danger="true" ConfirmText="Delete endpoint" OnConfirm="DeleteEndpoint" OnCancel="() => _confirm = Confirm.None">
                        <p>
                            @if (_liveVersion is not null)
                            {
                                <span>The gateway stops serving <code>@_form.Method /bff/@_form.Route.Trim('/')</code> within a few seconds. Apps that still call it get <strong>404 not_found</strong>. </span>
                            }
                            @if (_hasDraft) { <span>Unpublished changes are removed too. </span> }
                            The history is kept, so a publisher can restore any version later.
                        </p>
                    </ConfirmBox>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public string? Id { get; set; }

    private bool IsNew => Id is null;
    private RecipeForm _form = new();
    private ConfigSnapshot? _snapshot;
    private TestOutcome? _test;
    private string? _status;
    private bool _justPublished; // shows the "Try it in API docs" link after a successful publish
    private bool _picking;
    private string _search = "";
    private readonly Dictionary<int, string> _extraTarget = new();

    private enum Confirm { None, Discard, Delete }
    private Capabilities _caps = new(false, false);
    private List<HistoryRow>? _history;
    private int? _liveVersion;   // the version the gateway serves now, if any
    private bool _hasDraft;      // there are unpublished changes
    private bool _deleted;       // not live, no draft, but there is history: shown from its last version
    private int? _viewing;
    private Recipe? _viewed;
    private int? _confirmRollBack;
    private Confirm _confirm;

    protected override async Task OnInitializedAsync()
    {
        var services = await Api.GetServicesAsync() ?? [];
        var profiles = await Api.GetAuthProfilesAsync() ?? [];
        _snapshot = new ConfigSnapshot(services, profiles, [], "admin-ui");
        _caps = await Api.GetCapabilitiesAsync();

        if (!IsNew) await LoadRecipe();
        for (var i = 1; i <= 20; i++) _extraTarget[i] = "";
    }

    /// <summary>The draft if there is one, else the live version, else (a deleted endpoint) the last version in the history.</summary>
    private async Task LoadRecipe()
    {
        await LoadHistory();
        // Live version and draft from the list, not the history: recipes added straight to config/recipes have no history.
        var summary = (await Api.GetRecipesAsync() ?? []).FirstOrDefault(r => r.Id == Id);
        _liveVersion = summary?.PublishedVersion;
        _hasDraft = summary?.HasDraft == true;
        _deleted = summary?.Deleted == true;

        if (await Api.GetRecipeAsync(Id!) is { } recipe)
        {
            _form = RecipeForm.FromRecipe(recipe);
            return;
        }

        var last = _history?.FirstOrDefault(h => h.Action != HistoryAction.Unpublished);
        if (last is not null && await Api.GetVersionAsync(Id!, last.Version) is { } old) _form = RecipeForm.FromRecipe(old);
    }

    private async Task LoadHistory()
    {
        _history = await Api.GetHistoryAsync(Id!) ?? [];
        _viewing = null; _viewed = null; _confirmRollBack = null; _confirm = Confirm.None;
    }

    private int NextVersion => Math.Max(_liveVersion ?? 0, _history?.Select(h => h.Version).DefaultIfEmpty(0).Max() ?? 0) + 1;

    private static string Describe(HistoryRow row) => row.Action switch
    {
        HistoryAction.RolledBack => $"Rolled back: v{row.RestoredFrom} published again",
        HistoryAction.Unpublished => $"Deleted: v{row.Version} stopped being served",
        _ => "Published"
    };

    private static string When(DateTimeOffset? at) =>
        at?.ToUniversalTime().ToString("d MMM yyyy, HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture) ?? "Not recorded";

    private async Task ToggleView(int version)
    {
        if (_viewing == version) { _viewing = null; _viewed = null; return; }
        _viewed = await Api.GetVersionAsync(Id!, version);
        _viewing = _viewed is null ? null : version;
        if (_viewed is null) _status = $"Couldn't load version {version}.";
    }

    // ------------------------------------------------------------------ live checks (same validator as the server)

    private IReadOnlyList<ValidationIssue> Issues
    {
        get
        {
            try { return RecipeValidator.Validate(_form.ToRecipe(), _snapshot!).Issues; }
            catch (Exception ex) { return [new ValidationIssue("form", ex.Message)]; }
        }
    }

    /// <summary>Things worth a second look that don't block publishing (for example a risky combine key).</summary>
    private IReadOnlyList<ValidationIssue> Warnings
    {
        get
        {
            try { return RecipeValidator.Validate(_form.ToRecipe(), _snapshot!).Warnings; }
            catch (Exception) { return []; } // the problem itself is already shown under "Things to fix"
        }
    }

    private IReadOnlyList<SourceOption> SourcesFor(StepForm? step)
    {
        try { return new SourceCatalog().For(_form.ToRecipe(), step?.Alias, _snapshot!); }
        catch (Exception) { return []; }
    }

    private string RunsAfter(StepForm step)
    {
        try
        {
            var plan = ExecutionPlanner.Plan(_form.ToRecipe());
            var names = plan.DependsOn[step.Alias].Select(a => _form.Steps.FirstOrDefault(s => s.Alias == a)?.DisplayName ?? a);
            return string.Join(" and ", names);
        }
        catch (Exception) { return ""; }
    }

    // ------------------------------------------------------------------ form events

    private void OnNameChanged(string? name)
    {
        _form.Name = name ?? "";
        if (IsNew) _form.Id = Regex.Replace(_form.Name.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
    }

    private void OnRouteChanged(string? route)
    {
        _form.Route = route ?? "";
        foreach (Match m in Regex.Matches(_form.Route, @"\{([A-Za-z0-9_]+)\}"))
            if (!_form.Inputs.Any(i => i.Source == "route" && i.Name == m.Groups[1].Value))
                _form.Inputs.Add(new InputForm { Source = "route", Name = m.Groups[1].Value, Required = true });
    }

    private bool Matches(ApiService s, ApiEndpoint e) =>
        string.IsNullOrWhiteSpace(_search)
        || $"{s.Name} {e.Summary} {e.Id} {e.Method} {e.Path}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase);

    private void AddStep(ApiService service, ApiEndpoint endpoint)
    {
        var name = endpoint.Summary ?? Slug.Humanize(endpoint.Id);
        var step = new StepForm { DisplayName = name, Alias = _form.NewAlias(name) };
        _form.Steps.Add(step);
        OnEndpointChanged(step, $"{service.Id}/{endpoint.Id}");
        _picking = false;
    }

    /// <summary>Adds one response field per top-level field of the step's response (or the whole body if unknown).</summary>
    private void AddCombine()
    {
        var combine = new CombineForm { Name = _form.NewCombineName() };
        combine.Sources.Add(new CombineSourceForm());
        combine.Sources.Add(new CombineSourceForm());
        _form.Combines.Add(combine);
    }

    /// <summary>Adds the combined list to the response as a field with the same name (once).</summary>
    private void AddCombineToResponse(CombineForm combine)
    {
        var expression = $"combine.{combine.Name.Trim()}";
        if (!_form.Response.Any(f => f.Expression == expression))
            _form.Response.Add(new ResponseField { Name = combine.Name.Trim(), Expression = expression });
    }

    private void AddFieldsFrom(StepForm step)
    {
        var endpoint = _snapshot!.FindEndpoint(step.Endpoint, out _);
        var fields = endpoint?.ResponseSchema?["properties"] is JsonObject props ? props.Select(p => p.Key).ToList() : [];
        if (fields.Count == 0)
        {
            _form.Response.Add(new ResponseField { Name = step.Alias, Expression = $"{step.Alias}.body" });
            return;
        }
        foreach (var f in fields.Where(f => !_form.Response.Any(r => r.Name == f)))
            _form.Response.Add(new ResponseField { Name = f, Expression = $"{step.Alias}.body.{f}" });
    }

    private void OnEndpointChanged(StepForm step, string? reference)
    {
        step.Endpoint = reference ?? "";
        step.Bindings.Clear();
        var endpoint = _snapshot!.FindEndpoint(step.Endpoint, out _);
        if (endpoint is null) return;

        foreach (var p in AutoBinder.PathParams(endpoint.Path))
            step.Bindings[$"path.{p}"] = new BindingForm();
        foreach (var p in endpoint.Parameters.Where(p => p.In != "path"))
            step.Bindings[$"{p.In}.{p.Name}"] = new BindingForm();

        // Pre-fill what we can; the user confirms or changes it.
        foreach (var suggestion in AutoBinder.Suggest(_form.ToRecipe(), step.Alias, _snapshot))
            step.Bindings[suggestion.Target] = new BindingForm
            {
                Mode = BindingMode.FromSource, Expression = suggestion.Expression, Suggested = true, Reason = suggestion.Reason
            };
    }

    private static string SelectValue(BindingForm b) => b.Mode switch
    {
        BindingMode.FromSource => $"src:{b.Expression}",
        BindingMode.FixedValue => "fixed",
        _ => "none"
    };

    private static void OnBindingChanged(BindingForm binding, string? value)
    {
        binding.Suggested = false;
        if (value is null || value == "none") { binding.Mode = BindingMode.None; return; }
        if (value == "fixed") { binding.Mode = BindingMode.FixedValue; return; }
        binding.Mode = BindingMode.FromSource;
        binding.Expression = value["src:".Length..];
    }

    private void AddExtraValue(StepForm step, int number)
    {
        var target = _extraTarget[number].Trim();
        if (target.Contains('.')) step.Bindings[target] = new BindingForm();
        _extraTarget[number] = "";
    }

    // ------------------------------------------------------------------ actions

    private async Task<bool> SaveDraft()
    {
        var error = await Api.SaveDraftAsync(_form.ToRecipe());
        _justPublished = false;
        _status = error ?? "Draft saved. The live endpoint is unchanged until you publish.";
        if (error is null) _hasDraft = true;
        if (error is null && IsNew) Nav.NavigateTo($"/endpoints/{_form.Id}", replace: true);
        return error is null;
    }

    private async Task RunTest()
    {
        if (!await SaveDraft()) return;
        string? V(InputForm i) => string.IsNullOrWhiteSpace(i.TestValue) ? null : i.TestValue;
        _test = await Api.TestAsync(_form.Id,
            _form.Inputs.Where(i => i.Source == "route").ToDictionary(i => i.Name, V),
            _form.Inputs.Where(i => i.Source == "query").ToDictionary(i => i.Name, V),
            _form.Inputs.Where(i => i.Source == "header").ToDictionary(i => i.Name, V));
        _justPublished = false;
        _status = _test is null ? "The test couldn't run. Check that the Admin API is reachable." : null;
    }

    /// <summary>Swagger UI deep link to this endpoint: #/&lt;tag&gt;/&lt;operationId&gt;, the tag being the first part of the route.</summary>
    private string DocsLink
    {
        get
        {
            var gateway = (Config["Gateway:BaseUrl"] ?? "http://localhost:5200/").TrimEnd('/');
            var tag = _form.Route.Trim('/').Split('/')[0];
            if (tag.StartsWith('{')) tag = "other";
            return $"{gateway}/bff/docs#/{Uri.EscapeDataString(tag)}/{Uri.EscapeDataString(_form.Id)}";
        }
    }

    private async Task Publish()
    {
        var error = await Api.PublishAsync(_form.Id);
        _justPublished = error is null;
        _status = error ?? $"Published. Callers can use {_form.Method} /bff/{_form.Route.Trim('/')} now.";
        if (error is null) await LoadRecipe();
    }

    private async Task RollBack(int version)
    {
        var newVersion = NextVersion;
        var error = await Api.RollBackAsync(_form.Id, version);
        _justPublished = error is null;
        if (error is null) await LoadRecipe(); else _confirmRollBack = null;
        _status = error ?? $"Version {version} is live again, as v{newVersion}." +
            (_hasDraft ? " Your unpublished changes are still here: publishing them would replace it." : "");
    }

    private async Task DiscardDraft()
    {
        var error = await Api.DiscardDraftAsync(_form.Id);
        if (error is not null) { _status = error; _confirm = Confirm.None; return; }

        _test = null; _justPublished = false;
        await LoadRecipe();
        if (_liveVersion is null && !_deleted) { Nav.NavigateTo("/"); return; } // nothing left to show
        _status = _liveVersion is { } live ? $"Changes discarded. Showing the live version, v{live}." : "Changes discarded. Showing the last published version.";
    }

    private async Task DeleteEndpoint()
    {
        var address = $"{_form.Method} /bff/{_form.Route.Trim('/')}";
        var error = await Api.DeleteEndpointAsync(_form.Id);
        if (error is not null) { _status = error; _confirm = Confirm.None; return; }

        _test = null; _justPublished = false;
        await LoadRecipe();
        _status = _history is { Count: > 0 }
            ? $"Deleted. The gateway stops serving {address} within a few seconds. To restore it, roll back to a version under History."
            : "Deleted. It was never published, so nothing else changes.";
        if (_history is not { Count: > 0 }) Nav.NavigateTo("/");
    }
}
