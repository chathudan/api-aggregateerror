@page "/"
@inject AdminApiClient Api
@inject IConfiguration Config

<PageTitle>Aggregated endpoints</PageTitle>

<div class="header-row">
    <h1>Aggregated endpoints</h1>
    <div class="actions">
        <a class="button" href="@DocsUrl" target="_blank" rel="noopener">API docs</a>
        <a class="button primary" href="/endpoints/new">Create endpoint</a>
    </div>
</div>
<p class="muted">
    <a href="@SpecUrl" target="_blank" rel="noopener">OpenAPI spec</a>:
    download the spec for Postman, Insomnia or client generators.
</p>

@if (_recipes is null)
{
    <p class="muted">Loading…</p>
}
else if (_recipes.All(r => r.Deleted))
{
    <div class="card empty">
        <h2>Create your first aggregated endpoint</h2>
        <p>Combine calls to your services into one endpoint for web and mobile apps.</p>
        <a class="button" href="/endpoints/new">Create endpoint</a>
    </div>
}
else
{
    <table class="list">
        <thead><tr><th>Name</th><th>Address</th><th>Live version</th><th>Draft</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in _recipes.Where(r => !r.Deleted))
            {
                <tr>
                    <td><a href="/endpoints/@r.Id">@(string.IsNullOrEmpty(r.Name) ? r.Id : r.Name)</a></td>
                    <td><code>@r.Method @r.Route</code></td>
                    <td>@(r.PublishedVersion is { } v ? $"v{v}" : "Not published")</td>
                    <td>@(r.HasDraft ? "Unpublished changes" : "")</td>
                    <td>
                        @if (r.PublishedVersion is not null)
                        {
                            <a href="@DocsLink(r)" target="_blank" rel="noopener">Try in API docs</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_recipes?.Where(r => r.Deleted).ToList() is { Count: > 0 } deleted)
{
    <h2>Deleted endpoints <HelpLink Topic="delete" /></h2>
    <p class="hint">The gateway doesn't serve these. Their history is kept, so a publisher can bring one back.</p>
    <table class="list">
        <thead><tr><th>Name</th><th>Address it had</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in deleted)
            {
                <tr>
                    <td>@(string.IsNullOrEmpty(r.Name) ? r.Id : r.Name)</td>
                    <td><code>@r.Method @r.Route</code></td>
                    <td><a href="/endpoints/@r.Id#history">History and restore</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<RecipeSummary>? _recipes;

    // The gateway serves the docs page and the spec. Base URL ends with "/" (see appsettings).
    private string GatewayBase => (Config["Gateway:BaseUrl"] ?? "http://localhost:5200/").TrimEnd('/') + "/";
    private string DocsUrl => GatewayBase + "bff/docs";
    private string SpecUrl => GatewayBase + "bff/openapi.json";

    /// <summary>Swagger UI deep link: #/&lt;tag&gt;/&lt;operationId&gt;. The tag is the first part of the route.</summary>
    private string DocsLink(RecipeSummary r) => $"{DocsUrl}#/{Uri.EscapeDataString(DocsTag(r.Route))}/{Uri.EscapeDataString(r.Id)}";

    private static string DocsTag(string route)
    {
        var first = route.Trim('/').Split('/')[0];
        return first.StartsWith('{') ? "other" : first;
    }

    protected override async Task OnInitializedAsync() => _recipes = await Api.GetRecipesAsync() ?? [];
}
