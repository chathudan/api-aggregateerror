{
  "id": "unique-customers-2",
  "name": "Unique Customers",
  "version": 1,
  "status": "draft",
  "method": "GET",
  "route": "customer/unique2",
  "requireAuthentication": false,
  "inputs": {},
  "steps": [
    {
      "alias": "listContacts",
      "displayName": "Contacts from CRM",
      "endpoint": "service-f-crm/listContacts",
      "bind": [],
      "required": true,
      "maxConcurrency": 4,
      "distinct": true,
      "cache": {
        "enabled": false,
        "ttlSeconds": 30,
        "perCaller": true
      }
    },
    {
      "alias": "getOrders",
      "displayName": "Orders from CRM",
      "endpoint": "service-f-crm/listOrders",
      "bind": [],
      "required": true,
      "maxConcurrency": 4,
      "distinct": true,
      "cache": {
        "enabled": false,
        "ttlSeconds": 30,
        "perCaller": true
      }
    },
    {
      "alias": "notesForOneContact",
      "displayName": "Notes for each contact with an order",
      "endpoint": "service-f-crm/getContactNotes",
      "bind": [
        {
          "from": "item",
          "to": "path.contactId"
        }
      ],
      "required": true,
      "forEach": "{{ordersFromCrm.body.orders[*].contactId}}",
      "maxConcurrency": 4,
      "distinct": true,
      "cache": {
        "enabled": false,
        "ttlSeconds": 30,
        "perCaller": true
      }
    }
  ],
  "combine": {},
  "cache": {
    "enabled": false,
    "ttlSeconds": 30,
    "perCaller": true
  },
  "timeoutMs": 10000
}