{
  "id": "customer-directory",
  "name": "Customer directory",
  "version": 1,
  "status": "draft",
  "method": "GET",
  "route": "customers/directory",
  "requireAuthentication": true,
  "requiredScope": "customer.read",
  "inputs": {},
  "steps": [
    { "alias": "crm", "displayName": "Get CRM contacts", "endpoint": "service-a/listContacts" },
    { "alias": "billing", "displayName": "Get billing accounts", "endpoint": "service-b/listAccounts", "required": false }
  ],
  "combine": {
    "customers": {
      "sources": [
        { "from": "crm.body.contacts", "key": "customerId", "name": "crm" },
        { "from": "billing.body.accounts", "key": "customerId", "name": "billing" }
      ],
      "normalize": ["trim", "lower"],
      "onConflict": "priority",
      "owners": { "plan": "billing", "balance": "billing" },
      "nulls": "neverOverwrite",
      "withoutKey": "keep",
      "trackSources": true,
      "sortBy": "customerId",
      "maxRecords": 5000,
      "required": true
    }
  },
  "response": {
    "total": "{{combine.customers | count}}",
    "customers": "{{combine.customers}}"
  }
}
